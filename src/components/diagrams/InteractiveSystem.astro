---
import {
  GUIDED_TOUR_STEPS,
  SHARED_OPERATIONAL_CASE,
  SYSTEM_FORCE_CONCEPTS,
} from '../../lib/system3d/SystemEducationalData';

const concepts = SYSTEM_FORCE_CONCEPTS;
const initialConcept = concepts[0];
const tourSteps = GUIDED_TOUR_STEPS;
const sharedCase = SHARED_OPERATIONAL_CASE;
---

<div
  class="system-immersive-shell expandable-workbench"
  id="interactive-system"
  data-expanded="false"
  data-focus-mode="false"
  data-system3d-mode="pending"
  data-autoplay="false"
  data-presentation-mode="false"
>
  <header class="system-pres-topbar" id="system-pres-topbar" aria-label="Controles superiores de presentación">
    <div>
      <strong>OPEX LÍDER · 02 Sistema interactivo</strong>
      <span class="canvas-hint">Las 4 fuerzas · Modo presentación</span>
    </div>
    <button type="button" class="sys-ctrl-btn" id="system-pres-exit-btn">Salir [ESC]</button>
  </header>

  <div class="system-stage-topbar">
    <div class="system-stage-meta">
      <span class="canvas-kicker">SISTEMA DE 4 FUERZAS · ESCENARIO 3D</span>
      <span class="canvas-hint" id="system-stage-hint">
        Explora cómo Personas, Procesos, Liderazgo y Mejora intervienen ante una solicitud con riesgo de retraso
      </span>
    </div>
    <button
      type="button"
      class="focus-mode-toggle-btn"
      id="system-focus-mode-btn"
      aria-pressed="false"
      title="Ampliar escala visual para reuniones o proyección"
    >
      <span aria-hidden="true">⤢</span> Modo Enfoque
    </button>
  </div>

  <div class="stage-selector-bar system-selector-bar" role="tablist" aria-label="Acceso rápido a las 4 fuerzas">
    {concepts.map((c) => (
      <button
        type="button"
        class="stage-pill-btn"
        data-force-pill={c.id}
        role="tab"
        aria-selected="false"
      >
        <span class="stage-pill-num">{c.number}</span> {c.shortTitle}
      </button>
    ))}
  </div>

  <div class="system3d-controls" role="toolbar" aria-label="Controles del sistema 3D">
    <button type="button" class="sys-ctrl-btn is-active" id="system-ctrl-explore" aria-pressed="true">Explorar</button>
    <button type="button" class="sys-ctrl-btn" id="system-ctrl-relations" aria-pressed="false">Ver relaciones</button>
    <button type="button" class="sys-ctrl-btn" id="system-ctrl-tour" aria-pressed="false">Recorrido guiado</button>
    <button type="button" class="sys-ctrl-btn" id="system-ctrl-present" aria-pressed="false">Modo presentación</button>
    <button type="button" class="sys-ctrl-btn" id="system-ctrl-pause" aria-pressed="false">Pausar</button>
    <button type="button" class="sys-ctrl-btn" id="system-ctrl-restore">Restaurar</button>
  </div>

  <div class="system3d-tour-bar" id="system-tour-bar" hidden aria-label="Pasos del recorrido guiado">
    {tourSteps.map((step) => (
      <button
        type="button"
        class="tour-step-chip"
        data-tour-step={step.index}
        aria-label={`Paso ${step.index}: ${step.label}`}
      >
        {step.index}
      </button>
    ))}
    <button type="button" class="sys-ctrl-btn" id="system-tour-prev">Anterior</button>
    <button type="button" class="sys-ctrl-btn" id="system-tour-next">Siguiente</button>
  </div>

  <div class="system-stage-viewport" id="system-stage-viewport">
    <div class="system3d-stage" id="system3d-stage" aria-label="Escenario tridimensional del sistema operacional">
      <canvas class="system3d-canvas" id="system3d-canvas" aria-label="Escena 3D interactiva de las cuatro fuerzas"></canvas>
      <div class="system3d-labels" id="system3d-labels" aria-hidden="true">
        <span class="system3d-label" data-id="sistema">SISTEMA</span>
        <span class="system3d-label" data-id="personas">PERSONAS</span>
        <span class="system3d-label" data-id="procesos">PROCESOS</span>
        <span class="system3d-label" data-id="liderazgo">LIDERAZGO</span>
        <span class="system3d-label" data-id="mejora">MEJORA</span>
      </div>
    </div>

    <!-- Fallback 2.5D conservado (equivalencia funcional si WebGL no está disponible) -->
    <div
      class="diagram-canvas"
      id="system-diagram-canvas"
      role="group"
      aria-label="Seleccionar una de las 4 fuerzas de la excelencia operacional"
    >
      <div class="diagram-ring diagram-ring-outer" aria-hidden="true"></div>
      <div class="diagram-ring diagram-ring-inner" aria-hidden="true"></div>

      <svg class="diagram-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <line id="line-personas-procesos" x1="50" y1="14" x2="86" y2="50" pathLength="1" />
        <line id="line-procesos-liderazgo" x1="86" y1="50" x2="50" y2="86" pathLength="1" />
        <line id="line-liderazgo-mejora" x1="50" y1="86" x2="14" y2="50" pathLength="1" />
        <line id="line-personas-mejora" x1="14" y1="50" x2="50" y2="14" pathLength="1" />
        <line id="line-personas-nexus" x1="50" y1="14" x2="50" y2="50" stroke-dasharray="2 3" pathLength="1" />
        <line id="line-procesos-nexus" x1="86" y1="50" x2="50" y2="50" stroke-dasharray="2 3" pathLength="1" />
        <line id="line-liderazgo-nexus" x1="50" y1="86" x2="50" y2="50" stroke-dasharray="2 3" pathLength="1" />
        <line id="line-mejora-nexus" x1="14" y1="50" x2="50" y2="50" stroke-dasharray="2 3" pathLength="1" />
      </svg>

      <div class="diagram-center-nexus" id="diagram-center-nexus" aria-hidden="true">
        <div>
          <span id="nexus-kicker">NEXO VIVO · 00</span>
          <strong>SISTEMA</strong>
          <i></i>
        </div>
      </div>

      {concepts.map((concept, index) => (
        <button
          type="button"
          id={`btn-concept-${concept.id}`}
          class={`system-node-button ${concept.nodeClass}`}
          data-id={concept.id}
          data-index={index}
          aria-pressed="false"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="system-card-panel"
        >
          <span class="node-number">{concept.number}</span>
          <strong class="node-title">{concept.shortTitle}</strong>
          <i aria-hidden="true"></i>
        </button>
      ))}
    </div>

    <div class="system-stage-scrim" id="system-stage-scrim" aria-hidden="true"></div>

    <article
      class="system-card-panel system-expanded-dialog"
      id="system-card-panel"
      role="dialog"
      aria-modal="false"
      aria-labelledby="card-title"
      aria-hidden="true"
      hidden
    >
      <div>
        <div class="system-card-header" id="system-drag-handle" data-drag-handle>
          <div class="system-card-meta">
            <span class="system-card-badge" id="card-badge">{initialConcept.badge}</span>
            <span class="system-card-step" id="card-step">01 / 04</span>
          </div>
          <button
            type="button"
            class="expanded-close-btn"
            id="system-close-btn"
            aria-label="Cerrar tarjeta de fuerza y volver al sistema"
          >
            <span aria-hidden="true">✕</span> Cerrar
          </button>
        </div>

        <div class="system-connection-strip">
          <span class="system-card-links" id="card-links">Conecta: {initialConcept.connectionLabel}</span>
          <div class="system-connected-chips" id="card-connected-chips" aria-label="Explorar fuerzas conectadas"></div>
        </div>

        <h3 class="system-card-title" id="card-title">{initialConcept.title}</h3>
        <p class="system-card-summary" id="card-subtitle">{initialConcept.subtitle}</p>

        <div class="system-card-details">
          <p id="card-explanation">{initialConcept.explanation}</p>
        </div>

        <div class="system-card-grid-2col">
          <div class="system-card-relation">
            <span>RELACIÓN CON EL SISTEMA</span>
            <p id="card-relation">{initialConcept.systemRelation}</p>
          </div>
          <div class="system-card-leader-action">
            <span>APLICACIÓN · ACCIÓN DEL LÍDER</span>
            <p id="card-action">{initialConcept.leaderAction}</p>
          </div>
        </div>
      </div>

      <div class="system-card-footer-nav">
        <div class="expanded-nav-group">
          <button type="button" class="step-nav-btn" id="system-prev-btn">← Fuerza anterior</button>
          <button type="button" class="step-nav-btn" id="system-next-btn">Siguiente fuerza →</button>
        </div>
        <button type="button" class="expanded-return-btn" id="system-return-btn">
          Volver al sistema completo [ESC]
        </button>
      </div>
    </article>
  </div>

  <aside class="system3d-brief" id="system3d-brief" hidden aria-live="polite">
    <span class="system3d-brief-kicker" id="brief-kicker">CASO COMPARTIDO</span>
    <h3 id="brief-title">{sharedCase.title}</h3>
    <span class="system3d-beat" id="brief-beat" hidden></span>
    <p id="brief-body">{sharedCase.situation}</p>
    <p id="brief-learning"></p>
    <div class="system3d-brief-actions">
      <button type="button" class="sys-ctrl-btn" id="system-open-card-btn">Ver explicación completa</button>
      <button type="button" class="sys-ctrl-btn" id="system-close-brief-btn">Ocultar</button>
    </div>
  </aside>

  <div class="system-pres-hud" id="system-pres-hud">
    <button type="button" class="sys-ctrl-btn" id="system-pres-prev">Anterior</button>
    <span id="system-pres-status">Vista general</span>
    <button type="button" class="sys-ctrl-btn" id="system-pres-next">Siguiente</button>
  </div>
</div>

<script type="application/json" id="concepts-data" is:inline set:html={JSON.stringify(concepts)}></script>
<script type="application/json" id="tour-steps-data" is:inline set:html={JSON.stringify(tourSteps)}></script>
<script type="application/json" id="shared-case-data" is:inline set:html={JSON.stringify(sharedCase)}></script>

<script>
  import {
    animateFlipOpen,
    animateFlipClose,
    animateProgressiveConnections,
    makeCardDraggable,
  } from '../../lib/expandableCardEngine';
  import { createPresentationController, type PresentationScene } from '../../lib/presentationEngine';
  import { SystemAppStateController } from '../../lib/system3d/SystemAppState';
  import type { ForceId, SystemForceConcept } from '../../lib/system3d/SystemEducationalData';

  function setupInteractiveSystem() {
    const shell = document.getElementById('interactive-system');
    const rawData = document.getElementById('concepts-data')?.textContent;
    if (!shell || !rawData || shell.hasAttribute('data-initialized')) return;
    shell.setAttribute('data-initialized', 'true');

    let concepts: SystemForceConcept[] = [];
    try {
      concepts = JSON.parse(rawData);
    } catch {
      return;
    }

    const appState = new SystemAppStateController();
    const buttons = Array.from(shell.querySelectorAll<HTMLButtonElement>('.system-node-button'));
    const forcePills = Array.from(shell.querySelectorAll<HTMLButtonElement>('[data-force-pill]'));
    const svgLines = Array.from(shell.querySelectorAll<SVGLineElement>('.diagram-svg line'));
    const centerNexus = document.getElementById('diagram-center-nexus');
    const nexusKicker = document.getElementById('nexus-kicker');
    const panel = document.getElementById('system-card-panel') as HTMLElement | null;
    const dragHandle = document.getElementById('system-drag-handle');
    const scrim = document.getElementById('system-stage-scrim');
    const stageHint = document.getElementById('system-stage-hint');
    const focusModeBtn = document.getElementById('system-focus-mode-btn');
    const briefEl = document.getElementById('system3d-brief');
    const briefKicker = document.getElementById('brief-kicker');
    const briefTitle = document.getElementById('brief-title');
    const briefBody = document.getElementById('brief-body');
    const briefLearning = document.getElementById('brief-learning');
    const briefBeat = document.getElementById('brief-beat');
    const tourBar = document.getElementById('system-tour-bar');
    const tourChips = Array.from(shell.querySelectorAll<HTMLButtonElement>('[data-tour-step]'));
    const labelEls = Array.from(shell.querySelectorAll<HTMLElement>('.system3d-label'));

    const dragCtrl = panel
      ? makeCardDraggable({ cardEl: panel, handleEl: dragHandle, boundaryEl: shell })
      : null;

    const cardBadge = document.getElementById('card-badge');
    const cardLinks = document.getElementById('card-links');
    const cardStep = document.getElementById('card-step');
    const cardTitle = document.getElementById('card-title');
    const cardSubtitle = document.getElementById('card-subtitle');
    const cardExplanation = document.getElementById('card-explanation');
    const cardRelation = document.getElementById('card-relation');
    const cardAction = document.getElementById('card-action');
    const connectedChips = document.getElementById('card-connected-chips');
    const closeBtn = document.getElementById('system-close-btn');
    const returnBtn = document.getElementById('system-return-btn');
    const prevBtn = document.getElementById('system-prev-btn');
    const nextBtn = document.getElementById('system-next-btn');
    const synthesisCols = document.querySelectorAll<HTMLElement>('.synthesis-col[data-concept-id]');

    let sceneCtrl: {
      selectForce: (id: ForceId | null, playStory?: boolean) => void;
      setRelationsMode: (v: boolean) => void;
      restoreOverview: () => void;
      togglePause: () => boolean;
      pauseStories: () => void;
      resumeStories: () => void;
      dispose: () => void;
      getDiagnosticSnapshot: () => unknown;
      setCaptureFreeze: (v: boolean) => void;
    } | null = null;

    let isCardOpen = false;
    let currentIdx = 0;
    let lastOriginBtn: HTMLButtonElement | null = null;

    const presentationScenes: PresentationScene[] = [
      {
        id: 'overview',
        number: '00',
        tag: 'SISTEMA',
        title: 'Sistema completo',
        summary: 'Las cuatro fuerzas integran un sistema operacional vivo.',
      },
      ...concepts.map((c) => ({
        id: c.id,
        number: c.number,
        tag: c.shortTitle,
        title: c.title,
        summary: c.briefContext,
        relation: c.systemRelation,
        application: c.leaderAction,
        connectedNodes: c.connectedIds,
      })),
      {
        id: 'integration',
        number: '05',
        tag: 'INTEGRACIÓN',
        title: 'Integración didáctica',
        summary:
          'Las cuatro fuerzas se relacionan sobre el mismo caso. No forman una cadena universal obligatoria.',
      },
    ];

    const presentation = createPresentationController({
      containerEl: shell,
      scenes: presentationScenes,
      autoPlayIntervalMs: 7000,
      onSceneChange: (scene, index, isOverview) => {
        const status = document.getElementById('system-pres-status');
        if (status) {
          status.textContent = isOverview
            ? 'Vista general'
            : scene
              ? `${scene.number} · ${scene.title}`
              : 'Vista general';
        }
        if (isOverview || !scene || scene.id === 'overview') {
          appState.restore();
          sceneCtrl?.restoreOverview();
          return;
        }
        if (scene.id === 'integration') {
          appState.setRelationsVisible(true);
          sceneCtrl?.setRelationsMode(true);
          sceneCtrl?.selectForce(null, false);
          return;
        }
        const forceId = scene.id as ForceId;
        if (concepts.some((c) => c.id === forceId)) {
          appState.selectForce(forceId, { keepTour: true });
          sceneCtrl?.selectForce(forceId, true);
          syncFallbackSelection(forceId, false);
        }
        void index;
      },
      onEnter: () => {
        shell.setAttribute('data-presentation-mode', 'true');
        document.getElementById('system-ctrl-present')?.classList.add('is-active');
        document.getElementById('system-ctrl-present')?.setAttribute('aria-pressed', 'true');
      },
      onExit: () => {
        shell.setAttribute('data-presentation-mode', 'false');
        document.getElementById('system-ctrl-present')?.classList.remove('is-active');
        document.getElementById('system-ctrl-present')?.setAttribute('aria-pressed', 'false');
      },
    });

    function renderConnectedForceChips(connectedIds: string[]) {
      if (!connectedChips) return;
      connectedChips.innerHTML = '';
      connectedIds.forEach((cid) => {
        const targetConcept = concepts.find((c) => c.id === cid);
        if (!targetConcept) return;
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'insight-chip-btn';
        chip.textContent = `→ ${targetConcept.shortTitle}`;
        chip.addEventListener('click', () => selectForce(cid as ForceId, false));
        connectedChips.appendChild(chip);
      });
    }

    function fillCard(concept: SystemForceConcept) {
      if (cardBadge) cardBadge.textContent = concept.badge;
      if (cardLinks) cardLinks.textContent = `Conecta: ${concept.connectionLabel}`;
      if (cardStep) cardStep.textContent = `${concept.number} / 04`;
      if (cardTitle) cardTitle.textContent = concept.title;
      if (cardSubtitle) cardSubtitle.textContent = concept.subtitle;
      if (cardExplanation) cardExplanation.textContent = concept.explanation;
      if (cardRelation) cardRelation.textContent = concept.systemRelation;
      if (cardAction) cardAction.textContent = concept.leaderAction;
      renderConnectedForceChips(concept.connectedIds);
    }

    function syncFallbackSelection(forceId: ForceId, openCard: boolean) {
      const idx = concepts.findIndex((c) => c.id === forceId);
      if (idx < 0) return;
      currentIdx = idx;
      const concept = concepts[idx];
      lastOriginBtn = buttons[idx] || null;

      buttons.forEach((btn) => {
        const id = btn.getAttribute('data-id') || '';
        const isMatch = id === forceId;
        const isConnected = concept.connectedIds.includes(id as ForceId);
        btn.classList.toggle('active', isMatch);
        btn.classList.toggle('is-connected', isConnected);
        btn.classList.toggle('is-dimmed', !isMatch && !isConnected);
        btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
        btn.setAttribute('aria-expanded', openCard && isMatch ? 'true' : 'false');
      });

      forcePills.forEach((p) => {
        const active = p.getAttribute('data-force-pill') === forceId;
        p.classList.toggle('is-active', active);
        p.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      synthesisCols.forEach((col) => {
        col.classList.toggle('is-active', col.getAttribute('data-concept-id') === forceId);
      });

      labelEls.forEach((label) => {
        label.classList.toggle('is-active', label.getAttribute('data-id') === forceId);
      });

      const activeSvgLines: SVGElement[] = [];
      svgLines.forEach((line) => {
        const lineId = line.getAttribute('id');
        const isHighlighted = Boolean(lineId && concept.svgLines.includes(lineId));
        line.classList.toggle('active', isHighlighted);
        if (isHighlighted) activeSvgLines.push(line);
      });
      animateProgressiveConnections(activeSvgLines, 55);

      if (nexusKicker) nexusKicker.textContent = `NEXO VIVO · ${concept.number}`;
      if (centerNexus) {
        centerNexus.classList.remove('is-pulsing');
        void centerNexus.offsetWidth;
        centerNexus.classList.add('is-pulsing');
      }

      fillCard(concept);
      if (openCard) openCardPanel(true);
    }

    function openCardPanel(focusClose = true) {
      if (!panel || !shell) return;
      const concept = concepts[currentIdx];
      if (!concept) return;
      const wasOpen = isCardOpen;
      isCardOpen = true;
      appState.openCard();
      shell.setAttribute('data-expanded', 'true');
      shell.setAttribute('data-active-force', concept.id);
      panel.hidden = false;
      panel.setAttribute('aria-hidden', 'false');
      if (!wasOpen) {
        animateFlipOpen(lastOriginBtn, panel, { durationOpen: 390 });
      } else {
        panel.classList.remove('is-updated');
        void panel.offsetWidth;
        panel.classList.add('is-updated');
      }
      if (focusClose) setTimeout(() => closeBtn?.focus({ preventScroll: true }), 60);
    }

    function closeCardPanel() {
      if (!isCardOpen || !panel || !shell) return;
      const originToFocus = lastOriginBtn || buttons[currentIdx] || null;
      animateFlipClose(originToFocus, panel, () => {
        isCardOpen = false;
        appState.closeCard();
        dragCtrl?.resetPosition(false);
        shell.setAttribute('data-expanded', 'false');
        panel.hidden = true;
        panel.setAttribute('aria-hidden', 'true');
        originToFocus?.focus({ preventScroll: true });
      });
    }

    function updateBriefFromState() {
      const snap = appState.getSnapshot();
      if (!briefEl) return;
      if (!snap.briefOpen && !snap.concept && snap.tourStep.id !== 'integration') {
        briefEl.hidden = true;
        return;
      }
      briefEl.hidden = false;
      if (snap.concept) {
        if (briefKicker) briefKicker.textContent = `${snap.concept.badge}`;
        if (briefTitle) briefTitle.textContent = `${snap.concept.number} · ${snap.concept.title}`;
        if (briefBody) briefBody.textContent = snap.concept.briefContext;
        if (briefLearning) briefLearning.textContent = snap.concept.learningOutcome;
      } else if (snap.tourStep.id === 'integration') {
        if (briefKicker) briefKicker.textContent = 'INTEGRACIÓN';
        if (briefTitle) briefTitle.textContent = snap.tourStep.label;
        if (briefBody) briefBody.textContent = snap.tourStep.summary;
        if (briefLearning) {
          briefLearning.textContent =
            'Caso compartido: una solicitud con riesgo de retraso. Las fuerzas se relacionan; no son una secuencia obligatoria.';
        }
      }
      if (briefBeat) {
        if (snap.currentBeatLabel) {
          briefBeat.hidden = false;
          briefBeat.textContent = `Acción: ${snap.currentBeatLabel}`;
        } else {
          briefBeat.hidden = true;
          briefBeat.textContent = '';
        }
      }
    }

    function selectForce(forceId: ForceId, fromTour = false) {
      appState.selectForce(forceId, { keepTour: fromTour });
      sceneCtrl?.selectForce(forceId, true);
      syncFallbackSelection(forceId, false);
      updateBriefFromState();
      if (stageHint) {
        const concept = concepts.find((c) => c.id === forceId);
        stageHint.textContent = concept
          ? `Explorando ${concept.number} · ${concept.title}. Observa la acción 3D; la ficha completa es opcional.`
          : stageHint.textContent;
      }
    }

    function restoreAll() {
      appState.restore();
      sceneCtrl?.restoreOverview();
      closeCardPanel();
      buttons.forEach((btn) => {
        btn.classList.remove('active', 'is-connected', 'is-dimmed');
        btn.setAttribute('aria-pressed', 'false');
        btn.setAttribute('aria-expanded', 'false');
      });
      forcePills.forEach((p) => {
        p.classList.remove('is-active');
        p.setAttribute('aria-selected', 'false');
      });
      labelEls.forEach((l) => l.classList.remove('is-active'));
      svgLines.forEach((line) => line.classList.remove('active'));
      if (nexusKicker) nexusKicker.textContent = 'NEXO VIVO · 00';
      if (tourBar) tourBar.hidden = true;
      document.getElementById('system-ctrl-tour')?.classList.remove('is-active');
      document.getElementById('system-ctrl-relations')?.classList.remove('is-active');
      document.getElementById('system-ctrl-relations')?.setAttribute('aria-pressed', 'false');
      document.getElementById('system-ctrl-tour')?.setAttribute('aria-pressed', 'false');
      if (briefEl) briefEl.hidden = true;
      if (stageHint) {
        stageHint.textContent =
          'Explora cómo Personas, Procesos, Liderazgo y Mejora intervienen ante una solicitud con riesgo de retraso';
      }
      updateBriefFromState();
    }

    appState.subscribe((snap) => {
      if (tourBar) tourBar.hidden = !snap.isTourActive;
      tourChips.forEach((chip) => {
        const idx = Number(chip.getAttribute('data-tour-step'));
        chip.classList.toggle('is-active', snap.isTourActive && idx === snap.tourStepIndex);
      });
      updateBriefFromState();
    });

    buttons.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id') as ForceId | null;
        if (!id) return;
        if (isCardOpen && currentIdx === idx) closeCardPanel();
        else selectForce(id, false);
      });
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          e.stopPropagation();
          const next = buttons[(idx + 1) % buttons.length];
          next?.focus();
          const nextId = next?.getAttribute('data-id') as ForceId | null;
          if (nextId && (isCardOpen || appState.getSnapshot().activeForce)) selectForce(nextId, false);
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          e.stopPropagation();
          const prev = buttons[(idx - 1 + buttons.length) % buttons.length];
          prev?.focus();
          const prevId = prev?.getAttribute('data-id') as ForceId | null;
          if (prevId && (isCardOpen || appState.getSnapshot().activeForce)) selectForce(prevId, false);
        }
      });
    });

    forcePills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const id = pill.getAttribute('data-force-pill') as ForceId | null;
        if (id) selectForce(id, false);
      });
    });

    synthesisCols.forEach((col) => {
      col.addEventListener('click', () => {
        const colId = col.getAttribute('data-concept-id') as ForceId | null;
        if (colId) {
          shell.scrollIntoView({ behavior: 'smooth', block: 'center' });
          selectForce(colId, false);
        }
      });
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeCardPanel();
    });
    returnBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeCardPanel();
    });
    scrim?.addEventListener('click', closeCardPanel);

    prevBtn?.addEventListener('click', () => {
      const nextIdx = (currentIdx - 1 + concepts.length) % concepts.length;
      selectForce(concepts[nextIdx].id, false);
      if (isCardOpen) openCardPanel(false);
    });
    nextBtn?.addEventListener('click', () => {
      const nextIdx = (currentIdx + 1) % concepts.length;
      selectForce(concepts[nextIdx].id, false);
      if (isCardOpen) openCardPanel(false);
    });

    document.getElementById('system-open-card-btn')?.addEventListener('click', () => {
      if (appState.getSnapshot().activeForce) openCardPanel(true);
    });
    document.getElementById('system-close-brief-btn')?.addEventListener('click', () => {
      if (briefEl) briefEl.hidden = true;
    });

    document.getElementById('system-ctrl-relations')?.addEventListener('click', () => {
      const enabled = appState.toggleRelations();
      sceneCtrl?.setRelationsMode(enabled);
      const btn = document.getElementById('system-ctrl-relations');
      btn?.classList.toggle('is-active', enabled);
      btn?.setAttribute('aria-pressed', enabled ? 'true' : 'false');
      if (enabled && stageHint) {
        stageHint.textContent =
          'Relaciones activas: las conexiones muestran interdependencia educativa, no una cadena obligatoria.';
      }
    });

    document.getElementById('system-ctrl-tour')?.addEventListener('click', () => {
      appState.startTour(0);
      sceneCtrl?.restoreOverview();
      const btn = document.getElementById('system-ctrl-tour');
      btn?.classList.add('is-active');
      btn?.setAttribute('aria-pressed', 'true');
      if (tourBar) tourBar.hidden = false;
    });

    document.getElementById('system-tour-next')?.addEventListener('click', () => {
      appState.nextTourStep();
      const snap = appState.getSnapshot();
      if (snap.activeForce) {
        sceneCtrl?.selectForce(snap.activeForce, true);
        syncFallbackSelection(snap.activeForce, false);
      } else if (snap.tourStep.id === 'integration') {
        sceneCtrl?.setRelationsMode(true);
        sceneCtrl?.selectForce(null, false);
      } else {
        sceneCtrl?.restoreOverview();
      }
    });
    document.getElementById('system-tour-prev')?.addEventListener('click', () => {
      appState.prevTourStep();
      const snap = appState.getSnapshot();
      if (snap.activeForce) {
        sceneCtrl?.selectForce(snap.activeForce, true);
        syncFallbackSelection(snap.activeForce, false);
      } else {
        sceneCtrl?.restoreOverview();
        sceneCtrl?.setRelationsMode(snap.relationsVisible);
      }
    });
    tourChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.getAttribute('data-tour-step'));
        appState.startTour(idx);
        const snap = appState.getSnapshot();
        if (snap.activeForce) {
          sceneCtrl?.selectForce(snap.activeForce, true);
          syncFallbackSelection(snap.activeForce, false);
        } else if (snap.tourStep.id === 'integration') {
          sceneCtrl?.setRelationsMode(true);
        } else {
          sceneCtrl?.restoreOverview();
        }
      });
    });

    document.getElementById('system-ctrl-pause')?.addEventListener('click', () => {
      const playing = sceneCtrl?.togglePause() ?? false;
      appState.setPaused(!playing);
      const btn = document.getElementById('system-ctrl-pause');
      btn?.classList.toggle('is-active', !playing);
      btn?.setAttribute('aria-pressed', (!playing).toString());
      if (btn) btn.textContent = playing ? 'Pausar' : 'Reanudar';
    });

    document.getElementById('system-ctrl-restore')?.addEventListener('click', restoreAll);
    document.getElementById('system-ctrl-explore')?.addEventListener('click', () => {
      document.getElementById('system-ctrl-explore')?.classList.add('is-active');
      restoreAll();
    });

    document.getElementById('system-ctrl-present')?.addEventListener('click', () => {
      if (presentation.isPresented()) presentation.exit();
      else presentation.enter(0);
    });
    document.getElementById('system-pres-exit-btn')?.addEventListener('click', () => presentation.exit());
    document.getElementById('system-pres-prev')?.addEventListener('click', () => presentation.prev());
    document.getElementById('system-pres-next')?.addEventListener('click', () => presentation.next());

    focusModeBtn?.addEventListener('click', () => {
      const active = shell.getAttribute('data-focus-mode') === 'true';
      shell.setAttribute('data-focus-mode', active ? 'false' : 'true');
      focusModeBtn.setAttribute('aria-pressed', active ? 'false' : 'true');
      focusModeBtn.classList.toggle('is-active', !active);
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (presentation.isPresented()) {
          e.preventDefault();
          presentation.exit();
          return;
        }
        if (isCardOpen) {
          e.preventDefault();
          closeCardPanel();
        }
      }
    });

    const urlParams = new URLSearchParams(window.location.search);
    const requestedConcept = urlParams.get('concept');
    const forceFallback = urlParams.get('webgl') === '0';
    const canvas = document.getElementById('system3d-canvas') as HTMLCanvasElement | null;
    const stageEl = document.getElementById('system3d-stage');

    if (forceFallback || !canvas || !stageEl) {
      shell.setAttribute('data-system3d-mode', 'fallback-2d');
    } else {
      import('../../lib/system3d/SystemScene3D')
        .then(({ SystemScene3DController }) => {
          const ctrl = new SystemScene3DController({
            canvas,
            container: stageEl,
            onSelectForce: (forceId) => selectForce(forceId, false),
            onHoverForce: (forceId) => {
              labelEls.forEach((label) => {
                const id = label.getAttribute('data-id');
                label.classList.toggle(
                  'is-active',
                  id === forceId || id === appState.getSnapshot().activeForce
                );
              });
            },
            onLabelsProjected: (labels) => {
              labels.forEach((item) => {
                const el = labelEls.find((n) => n.getAttribute('data-id') === item.id);
                if (!el) return;
                const onScreen =
                  item.xPercent >= -5 &&
                  item.xPercent <= 105 &&
                  item.yPercent >= -5 &&
                  item.yPercent <= 105;
                el.style.left = `${item.xPercent}%`;
                el.style.top = `${item.yPercent}%`;
                el.style.opacity = onScreen ? '1' : '0';
              });
            },
            onStoryBeat: (forceId, _idx, label) => {
              appState.setBeatLabel(label);
              void forceId;
            },
            onWebGLFallback: () => {
              shell.setAttribute('data-system3d-mode', 'fallback-2d');
            },
          });
          const ok = ctrl.init();
          if (ok) {
            sceneCtrl = ctrl;
            shell.setAttribute('data-system3d-mode', '3d');
            (window as unknown as Record<string, unknown>).__opexSystem3D = ctrl;
          } else {
            shell.setAttribute('data-system3d-mode', 'fallback-2d');
          }
        })
        .catch(() => {
          shell.setAttribute('data-system3d-mode', 'fallback-2d');
        });
    }

    if (requestedConcept && concepts.some((c) => c.id === requestedConcept)) {
      selectForce(requestedConcept as ForceId, false);
    }

    (window as unknown as Record<string, unknown>).__opexSystemAppState = appState;
  }

  setupInteractiveSystem();
  document.addEventListener('astro:page-load', setupInteractiveSystem);
</script>
