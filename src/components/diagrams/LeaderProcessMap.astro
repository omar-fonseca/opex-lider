---
// Página 03 — El líder dentro del proceso
// Fase 5C (Bloque B): Recorrido visual secuencial + Enfoque contextual 2.5D con aproximación de cámara y FLIP
---

<div class="interactive-workbench expandable-workbench" id="leader-process-workbench" data-expanded="false" data-focus-mode="false">
  <div class="expandable-stage" id="lp-stage">
    <div class="workbench-canvas expandable-canvas-wrap" id="lp-canvas-wrap">
      <div class="canvas-Topline">
        <div class="system-stage-meta">
          <span class="canvas-kicker">ARQUITECTURA DE CAMPO · RECORRIDO VISUAL EN EL GEMBA</span>
          <span class="canvas-hint" id="lp-state-hint">
            Recorre la secuencia del líder paso a paso o selecciona un nodo para aproximarte y ampliar cómo funciona
          </span>
        </div>
        <div class="lp-toolbar-actions">
          <button type="button" class="lp-sequence-btn" id="lp-sequence-step-btn" title="Avanzar en el recorrido visual del líder en el proceso">
            <span aria-hidden="true">▶</span> Recorrer secuencia (1/5)
          </button>
          <button type="button" class="focus-mode-toggle-btn" id="lp-focus-mode-btn" aria-pressed="false">
            <span aria-hidden="true">⤢</span> Modo Enfoque
          </button>
        </div>
      </div>

      <div class="stage-selector-bar" role="tablist" aria-label="Elementos del líder dentro del proceso">
        <button type="button" class="stage-pill-btn is-active" role="tab" aria-selected="true" data-leader-node="lider" data-interactive-node>
          <span class="stage-pill-num">01</span> Líder articulador
        </button>
        <button type="button" class="stage-pill-btn" role="tab" aria-selected="false" data-leader-node="personas" data-interactive-node>
          <span class="stage-pill-num">02</span> Personas y equipo
        </button>
        <button type="button" class="stage-pill-btn" role="tab" aria-selected="false" data-leader-node="actividades" data-interactive-node>
          <span class="stage-pill-num">03</span> Actividades y estándar
        </button>
        <button type="button" class="stage-pill-btn" role="tab" aria-selected="false" data-leader-node="decisiones" data-interactive-node>
          <span class="stage-pill-num">04</span> Decisiones en terreno
        </button>
        <button type="button" class="stage-pill-btn" role="tab" aria-selected="false" data-leader-node="resultados" data-interactive-node>
          <span class="stage-pill-num">05</span> Resultados sostenibles
        </button>
      </div>

      <!-- Ilustración vectorial original 2.5D de la célula operacional con grupo de cámara y pulsos de recorrido -->
      <svg class="interactive-svg" id="lp-main-svg" viewBox="0 0 820 400" role="img" aria-label="Diagrama interactivo del líder dentro del proceso conectando equipo, actividades, decisiones y resultados">
        <defs>
          <linearGradient id="lpFloorGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="rgba(30, 58, 110, 0.32)" />
            <stop offset="100%" stop-color="rgba(10, 22, 44, 0.14)" />
          </linearGradient>
          <filter id="lpGlow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="var(--accent)" flood-opacity="0.34" />
          </filter>
          <marker id="lpArrowBlue" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
            <path d="M 0 1 L 8 5 L 0 9 z" fill="var(--accent-strong)" />
          </marker>
          <marker id="lpArrowGreen" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
            <path d="M 0 1 L 8 5 L 0 9 z" fill="#34d399" />
          </marker>
        </defs>

        <g id="lp-camera-group" style="transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1); transform-origin: 410px 195px;">
          <!-- Plano 2.5D de soporte del proceso (Gemba) -->
          <polygon points="410,16 776,188 410,362 44,188" fill="url(#lpFloorGrad)" stroke="var(--accent-border)" stroke-width="1.2" />
          <polygon points="410,50 704,188 410,326 116,188" fill="none" stroke="var(--accent-subtle)" stroke-dasharray="4 6" />

          <!-- Conexiones vectoriales dinámicas con dirección de flujo -->
          <g id="lp-links" stroke="var(--accent-border)" stroke-width="2.2" fill="none">
            <path id="lp-edge-lider-personas" class="svg-flow-line lp-edge" data-edges="lider,personas" d="M 332 170 L 245 118" marker-end="url(#lpArrowBlue)" pathLength="1" />
            <path id="lp-edge-lider-actividades" class="svg-flow-line lp-edge" data-edges="lider,actividades" d="M 332 204 L 245 258" marker-end="url(#lpArrowBlue)" pathLength="1" />
            <path id="lp-edge-lider-decisiones" class="svg-flow-line lp-edge" data-edges="lider,decisiones" d="M 488 170 L 575 118" marker-end="url(#lpArrowBlue)" pathLength="1" />
            <path id="lp-edge-lider-resultados" class="svg-flow-line lp-edge" data-edges="lider,resultados" d="M 488 204 L 575 258" marker-end="url(#lpArrowGreen)" pathLength="1" />
            <!-- Circuito perimetral del proceso: Personas -> Actividades -> Decisiones -> Resultados -->
            <path id="lp-edge-personas-actividades" class="lp-edge" data-edges="personas,actividades" d="M 155 138 L 155 236" stroke-dasharray="4 5" marker-end="url(#lpArrowBlue)" pathLength="1" />
            <path id="lp-edge-actividades-decisiones" class="lp-edge" data-edges="actividades,decisiones" d="M 245 250 L 575 124" stroke-dasharray="4 5" pathLength="1" />
            <path id="lp-edge-personas-decisiones" class="lp-edge" data-edges="personas,decisiones" d="M 245 100 L 575 100" stroke-dasharray="4 5" marker-end="url(#lpArrowBlue)" pathLength="1" />
            <path id="lp-edge-decisiones-resultados" class="lp-edge" data-edges="decisiones,resultados" d="M 665 138 L 665 236" stroke-dasharray="4 5" marker-end="url(#lpArrowGreen)" pathLength="1" />
            <path id="lp-edge-actividades-resultados" class="lp-edge" data-edges="actividades,resultados" d="M 245 276 L 575 276" stroke-dasharray="4 5" marker-end="url(#lpArrowGreen)" pathLength="1" />
          </g>

          <!-- NODO 02: PERSONAS Y EQUIPO (Arriba Izquierda) -->
          <g class="svg-node-group" data-node-target="personas" tabindex="0" role="button" aria-haspopup="dialog" aria-expanded="false" aria-label="Ampliar Personas y equipo">
            <rect class="node-card-bg" x="65" y="62" width="180" height="76" rx="12" fill="rgba(13, 25, 48, 0.92)" stroke="rgba(148, 163, 184, 0.38)" stroke-width="1.6" />
            <circle cx="97" cy="94" r="14" fill="rgba(59, 130, 246, 0.2)" stroke="#60a5fa" stroke-width="1.5" />
            <circle cx="97" cy="90" r="4.5" fill="#93c5fd" />
            <path d="M88 103 C88 97, 106 97, 106 103" stroke="#93c5fd" stroke-width="1.6" fill="none" />
            <text x="122" y="86" fill="#93c5fd" font-family="DM Sans, sans-serif" font-size="9.5" font-weight="700" letter-spacing="1.2">02 · EQUIPO</text>
            <text x="230" y="86" text-anchor="end" fill="#60a5fa" font-family="DM Sans, sans-serif" font-size="9" font-weight="700">⤢</text>
            <text x="122" y="106" fill="#f8fafc" font-family="Manrope, sans-serif" font-size="13.5" font-weight="700">Personas y</text>
            <text x="122" y="122" fill="#cbd5e1" font-family="Manrope, sans-serif" font-size="11.5">capacidades</text>
          </g>

          <!-- NODO 03: ACTIVIDADES Y ESTÁNDAR (Abajo Izquierda) -->
          <g class="svg-node-group" data-node-target="actividades" tabindex="0" role="button" aria-haspopup="dialog" aria-expanded="false" aria-label="Ampliar Actividades y estándar">
            <rect class="node-card-bg" x="65" y="238" width="180" height="76" rx="12" fill="rgba(13, 25, 48, 0.92)" stroke="rgba(148, 163, 184, 0.38)" stroke-width="1.6" />
            <rect x="83" y="260" width="28" height="28" rx="6" fill="rgba(59, 130, 246, 0.2)" stroke="#60a5fa" stroke-width="1.5" />
            <path d="M89 270 H105 M89 276 H101 M89 282 H105" stroke="#93c5fd" stroke-width="1.6" stroke-linecap="round" />
            <text x="122" y="262" fill="#93c5fd" font-family="DM Sans, sans-serif" font-size="9.5" font-weight="700" letter-spacing="1.2">03 · EJECUCIÓN</text>
            <text x="230" y="262" text-anchor="end" fill="#60a5fa" font-family="DM Sans, sans-serif" font-size="9" font-weight="700">⤢</text>
            <text x="122" y="282" fill="#f8fafc" font-family="Manrope, sans-serif" font-size="13.5" font-weight="700">Actividades</text>
            <text x="122" y="298" fill="#cbd5e1" font-family="Manrope, sans-serif" font-size="11.5">y secuencia</text>
          </g>

          <!-- NODO 04: DECISIONES EN TERRENO (Arriba Derecha) -->
          <g class="svg-node-group" data-node-target="decisiones" tabindex="0" role="button" aria-haspopup="dialog" aria-expanded="false" aria-label="Ampliar Decisiones en terreno">
            <rect class="node-card-bg" x="575" y="62" width="180" height="76" rx="12" fill="rgba(13, 25, 48, 0.92)" stroke="rgba(148, 163, 184, 0.38)" stroke-width="1.6" />
            <polygon points="607,78 621,94 607,110 593,94" fill="rgba(59, 130, 246, 0.22)" stroke="#60a5fa" stroke-width="1.5" />
            <text x="632" y="86" fill="#93c5fd" font-family="DM Sans, sans-serif" font-size="9.5" font-weight="700" letter-spacing="1.2">04 · CRITERIO</text>
            <text x="740" y="86" text-anchor="end" fill="#60a5fa" font-family="DM Sans, sans-serif" font-size="9" font-weight="700">⤢</text>
            <text x="632" y="106" fill="#f8fafc" font-family="Manrope, sans-serif" font-size="13.5" font-weight="700">Decisiones</text>
            <text x="632" y="122" fill="#cbd5e1" font-family="Manrope, sans-serif" font-size="11.5">y priorización</text>
          </g>

          <!-- NODO 05: RESULTADOS SOSTENIBLES (Abajo Derecha) -->
          <g class="svg-node-group" data-node-target="resultados" tabindex="0" role="button" aria-haspopup="dialog" aria-expanded="false" aria-label="Ampliar Resultados del proceso">
            <rect class="node-card-bg" x="575" y="238" width="180" height="76" rx="12" fill="rgba(13, 25, 48, 0.92)" stroke="rgba(148, 163, 184, 0.38)" stroke-width="1.6" />
            <circle cx="607" cy="275" r="14" fill="rgba(16, 185, 129, 0.18)" stroke="#34d399" stroke-width="1.5" />
            <path d="M601 275 L605 280 L614 269" stroke="#34d399" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <text x="632" y="262" fill="#6ee7b7" font-family="DM Sans, sans-serif" font-size="9.5" font-weight="700" letter-spacing="1.2">05 · IMPACTO</text>
            <text x="740" y="262" text-anchor="end" fill="#6ee7b7" font-family="DM Sans, sans-serif" font-size="9" font-weight="700">⤢</text>
            <text x="632" y="282" fill="#f8fafc" font-family="Manrope, sans-serif" font-size="13.5" font-weight="700">Resultados</text>
            <text x="632" y="298" fill="#cbd5e1" font-family="Manrope, sans-serif" font-size="11.5">del proceso</text>
          </g>

          <!-- NODO CENTRAL 01: EL LÍDER DENTRO DEL PROCESO -->
          <g class="svg-node-group is-active" data-node-target="lider" tabindex="0" role="button" aria-haspopup="dialog" aria-expanded="false" aria-label="Ampliar rol del Líder articulador" filter="url(#lpGlow)">
            <rect class="node-card-bg" x="306" y="132" width="208" height="108" rx="16" fill="rgba(23, 49, 97, 0.95)" stroke="#60a5fa" stroke-width="2.2" />
            <circle cx="410" cy="162" r="15" fill="rgba(59, 130, 246, 0.28)" stroke="#93c5fd" stroke-width="1.6" />
            <path d="M404 162 L410 156 L416 162 M410 156 V169" stroke="#eff6ff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            <text x="410" y="192" text-anchor="middle" fill="#93c5fd" font-family="DM Sans, sans-serif" font-size="10" font-weight="700" letter-spacing="1.5">01 · NODO ARTICULADOR ⤢</text>
            <text x="410" y="212" text-anchor="middle" fill="#ffffff" font-family="Playfair Display, Georgia, serif" font-size="17" font-weight="700">El Líder en Terreno</text>
            <text x="410" y="229" text-anchor="middle" fill="#dbeafe" font-family="DM Sans, sans-serif" font-size="11">Orienta · Coordina · Desarrolla</text>
          </g>

          <!-- Pulso viajero animado para el recorrido visual secuencial -->
          <circle id="lp-traveler-dot" cx="410" cy="186" r="7" fill="#60a5fa" stroke="#ffffff" stroke-width="2" opacity="0" pointer-events="none" />
        </g>

        <!-- Barra inferior integrada en el lienzo: estado vivo del recorrido secuencial -->
        <rect x="44" y="346" width="732" height="42" rx="10" fill="rgba(11, 22, 42, 0.88)" stroke="rgba(96, 165, 250, 0.3)" />
        <text id="lp-journey-banner-step" x="64" y="365" fill="#60a5fa" font-family="Manrope, sans-serif" font-size="10" font-weight="700" letter-spacing="1.1">
          RECORRIDO DEL LÍDER · PASO 01 DE 05
        </text>
        <text id="lp-journey-banner-copy" x="64" y="381" fill="#f1f5f9" font-family="DM Sans, sans-serif" font-size="11.5">
          El líder habita el proceso (Gemba): traduce objetivos en condiciones claras antes de exigir velocidad.
        </text>
        <text x="756" y="374" text-anchor="end" fill="#93c5fd" font-family="DM Sans, sans-serif" font-size="10.5" font-weight="700">
          Haz clic en el nodo para ampliar ↗
        </text>
      </svg>
    </div>

    <div class="expandable-scrim" id="lp-scrim" aria-hidden="true"></div>

    <!-- Tarjeta editorial expandible (FLIP) con esquema vectorial específico de cada elemento -->
    <aside
      class="expanded-editorial-card"
      id="lp-inspector"
      role="dialog"
      aria-modal="false"
      aria-labelledby="lp-title"
      aria-hidden="true"
      hidden
    >
      <div class="expanded-topbar" id="lp-drag-handle" data-drag-handle>
        <div class="inspector-badge-row" style="margin-bottom: 0;">
          <span class="inspector-tag" id="lp-tag">01 · ROL CENTRAL</span>
          <span class="inspector-step-indicator" id="lp-step">Nodo 1 de 5</span>
        </div>
        <button type="button" class="expanded-close-btn" id="lp-close-btn" aria-label="Cerrar vista ampliada">
          <span aria-hidden="true">✕</span> Cerrar
        </button>
      </div>

      <div>
        <h3 class="inspector-title" id="lp-title">El líder como articulador del sistema</h3>
        <p class="inspector-summary" id="lp-summary">
          El líder operacional no dirige por control remoto ni se limita a auditar indicadores al final del turno. Su función principal es habitar el proceso para traducir los objetivos de la organización en condiciones claras de trabajo.
        </p>
      </div>

      <!-- Esquema vectorial específico del nodo ampliado + tira de recorrido -->
      <div class="expanded-magnified-box">
        <div class="expanded-magnified-header">
          <span>MECANISMO DE ARTICULACIÓN EN EL GEMBA</span>
          <span id="lp-micro-caption">Conexión directa: Líder ↔ Personas · Actividades · Decisiones · Resultados</span>
        </div>
        <div class="lp-micro-diagram-row">
          <svg class="lp-micro-svg" id="lp-micro-svg" viewBox="0 0 560 66" aria-hidden="true">
            <rect x="8" y="11" width="118" height="44" rx="8" fill="rgba(30, 58, 110, 0.55)" stroke="#60a5fa" stroke-width="1.6" />
            <text id="lp-svg-box1" x="67" y="37" text-anchor="middle" fill="#ffffff" font-family="Manrope, sans-serif" font-size="11" font-weight="700">01 · Líder en Gemba</text>
            <line x1="126" y1="33" x2="178" y2="33" stroke="#60a5fa" stroke-width="2" stroke-dasharray="4 3" />
            <rect x="178" y="11" width="184" height="44" rx="8" fill="rgba(16, 33, 64, 0.85)" stroke="#93c5fd" stroke-width="1.8" />
            <text id="lp-svg-box2" x="270" y="37" text-anchor="middle" fill="#93c5fd" font-family="Manrope, sans-serif" font-size="11" font-weight="700">Observa · Coordina · Elimina barreras</text>
            <line x1="362" y1="33" x2="414" y2="33" stroke="#34d399" stroke-width="2" />
            <rect x="414" y="11" width="138" height="44" rx="8" fill="rgba(16, 48, 56, 0.72)" stroke="#34d399" stroke-width="1.6" />
            <text id="lp-svg-box3" x="483" y="37" text-anchor="middle" fill="#6ee7b7" font-family="Manrope, sans-serif" font-size="11" font-weight="700">Flujo estable</text>
          </svg>
        </div>
        <div class="expanded-flow-strip">
          <span class="expanded-flow-pill is-current" data-lp-strip="lider">01 · Líder</span>
          <span class="expanded-flow-arrow">→</span>
          <span class="expanded-flow-pill" data-lp-strip="personas">02 · Personas</span>
          <span class="expanded-flow-arrow">→</span>
          <span class="expanded-flow-pill" data-lp-strip="actividades">03 · Actividades</span>
          <span class="expanded-flow-arrow">→</span>
          <span class="expanded-flow-pill" data-lp-strip="decisiones">04 · Decisiones</span>
          <span class="expanded-flow-arrow">→</span>
          <span class="expanded-flow-pill" data-lp-strip="resultados">05 · Resultados</span>
        </div>
      </div>

      <div class="expanded-detail-cols">
        <div class="inspector-detail-box">
          <span>RELACIÓN CON EL PROCESO</span>
          <p id="lp-relation">
            Conecta el propósito con la ejecución diaria: observa el flujo real, elimina fricciones entre etapas y asegura que cada persona comprenda qué se espera de su trabajo.
          </p>
        </div>
        <div class="inspector-detail-box">
          <span>COMPORTAMIENTO OBSERVABLE EN TERRENO</span>
          <p id="lp-application">
            Antes de pedir velocidad, verifica si el equipo cuenta con información clara, herramientas en buen estado y criterios para detener o escalar una anomalía.
          </p>
        </div>
      </div>

      <div class="expanded-footer-bar">
        <div class="expanded-nav-group">
          <button type="button" class="step-nav-btn" id="lp-prev-btn">← Elemento anterior</button>
          <button type="button" class="step-nav-btn" id="lp-next-btn">Siguiente elemento →</button>
        </div>
        <button type="button" class="expanded-return-btn" id="lp-return-btn">Volver al mapa del proceso [ESC]</button>
      </div>
    </aside>
  </div>
</div>

<script>
  import {
    animateFlipOpen,
    animateFlipClose,
    animateProgressiveConnections,
    makeCardDraggable,
    prefersReducedMotion,
  } from '../../lib/expandableCardEngine';

  function initLeaderProcessMap() {
    const root = document.getElementById('leader-process-workbench');
    const stageEl = document.getElementById('lp-stage');
    if (!root || root.hasAttribute('data-initialized')) return;
    root.setAttribute('data-initialized', 'true');

    const DATA: Record<string, {
      tag: string;
      step: string;
      title: string;
      summary: string;
      relation: string;
      application: string;
      bannerStep: string;
      bannerCopy: string;
      cameraTransform: string;
      nodeCoords: { x: number; y: number };
      microBoxes: [string, string, string];
      microCaption: string;
    }> = {
      lider: {
        tag: '01 · ROL CENTRAL',
        step: 'Nodo 1 de 5',
        title: 'El líder como articulador del sistema',
        summary:
