        badgeText: 'Flujo recuperado',
        badgeClass: 'is-ok',
        bottleneck: false,
        magnifiedHtml:
          '<strong>Cuello de botella resuelto:</strong> 4 órdenes completadas conformes y capacidad liberada en Preparación (1/2) y Ejecución (1/2).',
        counts: { cola: '0 en espera', prep: '1 / 2 MÁX', ejec: '1 / 2 MÁX', done: '4 completadas' },
