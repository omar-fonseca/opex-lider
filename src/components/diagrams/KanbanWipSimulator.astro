          cola: [],
          prep: [
            { id: 'OT-107', title: 'Revisión tablero', note: 'Ingresa con flujo limpio' },
          ],
          ejec: [
            { id: 'OT-105', title: 'Ajuste línea B', note: 'Avanza sin fricción' },
          ],
          done: [
            { id: 'OT-101', title: 'Limpieza filtro A', note: 'Cerrada conforme', status: 'done' },
            { id: 'OT-102', title: 'Cambio sello bomba', note: 'Entregada a tiempo', status: 'done' },
            { id: 'OT-104', title: 'Calibración sensor', note: 'Desbloqueada y validada', status: 'done' },
            { id: 'OT-103', title: 'Kit rodamientos', note: 'Completada en estándar', status: 'done' },
          ],
        },
      },
    };

    const keys = ['estable', 'avance', 'restriccion', 'desbloqueo'];
    let currentIdx = 0;
    let isExpanded = false;
    let lastOriginEl: HTMLElement | null = null;

    const pills = root.querySelectorAll<HTMLButtonElement>('[data-wip-state]');
    const lanes = root.querySelectorAll<HTMLElement>('.wip-lane');
    const inspector = document.getElementById('wip-inspector');
    const scrim = document.getElementById('wip-stage-scrim');
    const stateHint = document.getElementById('wip-state-hint');
    const openDetailBtn = document.getElementById('wip-open-detail-btn');
    const closeBtn = document.getElementById('wip-close-btn');
    const returnBtn = document.getElementById('wip-return-btn');

    const tagEl = document.getElementById('wip-tag');
    const stepEl = document.getElementById('wip-step');
    const titleEl = document.getElementById('wip-title');
    const summaryEl = document.getElementById('wip-summary');
    const flowEl = document.getElementById('wip-flow-note');
    const leaderEl = document.getElementById('wip-leader-note');
    const totalEl = document.getElementById('wip-total-value');
    const statusPill = document.getElementById('wip-status-pill');
    const magBadge = document.getElementById('wip-magnified-badge');
    const magCopy = document.getElementById('wip-magnified-copy');
    const laneEjec = document.getElementById('wip-lane-ejecucion');

    const countCola = document.getElementById('wip-count-cola');
    const countPrep = document.getElementById('wip-count-prep');
    const countEjec = document.getElementById('wip-count-ejec');
    const countDone = document.getElementById('wip-count-done');

    const slotCola = document.getElementById('wip-slot-cola');
    const slotPrep = document.getElementById('wip-slot-prep');
    const slotEjec = document.getElementById('wip-slot-ejec');
    const slotDone = document.getElementById('wip-slot-done');

    const prevBtn = document.getElementById('wip-prev-btn');
    const nextBtn = document.getElementById('wip-next-btn');

    if (inspector) {
      const stageEl = root.querySelector<HTMLElement>('.expandable-stage') || root;
      const handleEl = inspector.querySelector<HTMLElement>('.expanded-topbar') || inspector;
      makeCardDraggable({
        cardEl: inspector,
        handleEl,
        boundsEl: stageEl,
        storageKey: 'opex-drag-page-07',
      });
    }

    function renderCards(container: HTMLElement | null, cards: CardItem[]) {
      if (!container) return;
      container.innerHTML = '';
      if (cards.length === 0) {
        const empty = document.createElement('div');
        empty.style.fontSize = '11px';
        empty.style.color = 'var(--text-muted)';
        empty.style.padding = '8px 4px';
        empty.textContent = 'Cupo disponible';
        container.appendChild(empty);
        return;
      }
      cards.forEach((c) => {
        const card = document.createElement('div');
        card.className = `wip-work-card ${c.status === 'blocked' ? 'is-blocked' : ''} ${c.status === 'done' ? 'is-done' : ''}`;
        card.setAttribute('data-card-id', c.id);
        const idSpan = document.createElement('span');
        idSpan.className = 'wip-card-id';
        idSpan.textContent = `${c.id} ↗`;
        const titleStrong = document.createElement('strong');
        titleStrong.className = 'wip-card-title';
        titleStrong.textContent = c.title;
        const noteSpan = document.createElement('span');
        noteSpan.className = 'wip-card-note';
        noteSpan.textContent = c.note;
        card.append(idSpan, titleStrong, noteSpan);
        container.appendChild(card);
      });
    }

    function updateBoardAndCardData(key: string) {
      const i = keys.indexOf(key);
      if (i === -1) return;
      currentIdx = i;
      const sc = SCENARIOS[key];

      pills.forEach((p) => {
        const active = p.getAttribute('data-wip-state') === key;
        p.classList.toggle('is-active', active);
        p.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      laneEjec?.classList.toggle('is-bottleneck', sc.bottleneck);

      if (countCola) countCola.textContent = sc.counts.cola;
      if (countPrep) countPrep.textContent = sc.counts.prep;
      if (countEjec) countEjec.textContent = sc.counts.ejec;
      if (countDone) countDone.textContent = sc.counts.done;

      renderCards(slotCola, sc.lanes.cola);
      renderCards(slotPrep, sc.lanes.prep);
      renderCards(slotEjec, sc.lanes.ejec);
      renderCards(slotDone, sc.lanes.done);

      if (totalEl) totalEl.textContent = sc.wipTotal;
      if (statusPill) {
        statusPill.textContent = sc.badgeText;
        statusPill.className = `status-badge ${sc.badgeClass}`;
      }
      if (magBadge) {
        magBadge.textContent = sc.badgeText;
        magBadge.className = `status-badge ${sc.badgeClass}`;
      }
      if (magCopy) magCopy.innerHTML = sc.magnifiedHtml;
      if (tagEl) tagEl.textContent = sc.tag;
      if (stepEl) stepEl.textContent = sc.step;
      if (titleEl) titleEl.textContent = sc.title;
      if (summaryEl) summaryEl.textContent = sc.summary;
      if (flowEl) flowEl.textContent = sc.flowNote;
      if (leaderEl) leaderEl.textContent = sc.leaderNote;
    }

    function openExpandedDiagnosis(originEl: HTMLElement | null, focusClose = true) {
      if (!inspector) return;
      lastOriginEl = originEl || laneEjec || openDetailBtn;
      isExpanded = true;
      root.setAttribute('data-expanded', 'true');
      inspector.hidden = false;
      inspector.setAttribute('aria-hidden', 'false');

      if (stateHint) {
        stateHint.textContent = 'Explorando diagnóstico ampliado · Pulsa [X] o [Escape] para volver al tablero Kanban';
      }

      animateFlipOpen(lastOriginEl, inspector);

      if (focusClose) {
        setTimeout(() => closeBtn?.focus({ preventScroll: true }), 60);
      }
    }

    function closeExpandedDiagnosis() {
      if (!isExpanded || !inspector) return;
      const originToFocus = lastOriginEl;

      animateFlipClose(originToFocus, inspector, () => {
        isExpanded = false;
        root.setAttribute('data-expanded', 'false');
        inspector.hidden = true;
        inspector.setAttribute('aria-hidden', 'true');
        if (stateHint) {
          stateHint.textContent =
            'Selecciona un momento (M1–M4) o toca cualquier tarjeta/columna del tablero para ampliar su diagnóstico';
        }
        originToFocus?.focus({ preventScroll: true });
      });
    }

    // Estado inicial en el tablero (Cerrado para ver las 4 columnas completas)
    updateBoardAndCardData('estable');

    pills.forEach((p) => {
      p.addEventListener('click', () => {
        const k = p.getAttribute('data-wip-state');
        if (k) {
          updateBoardAndCardData(k);
          openExpandedDiagnosis(p, false);
        }
      });
    });

    lanes.forEach((lane) => {
      lane.addEventListener('click', (e) => {
        const targetCard = (e.target as HTMLElement)?.closest<HTMLElement>('.wip-work-card');
        openExpandedDiagnosis(targetCard || lane, true);
      });
      lane.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openExpandedDiagnosis(lane, true);
        }
      });
    });

    openDetailBtn?.addEventListener('click', () => {
      openExpandedDiagnosis(openDetailBtn, true);
    });

    closeBtn?.addEventListener('click', closeExpandedDiagnosis);
    returnBtn?.addEventListener('click', closeExpandedDiagnosis);
    scrim?.addEventListener('click', closeExpandedDiagnosis);

    prevBtn?.addEventListener('click', () => {
      const nextKey = keys[(currentIdx - 1 + keys.length) % keys.length];
      updateBoardAndCardData(nextKey);
      openExpandedDiagnosis(laneEjec, false);
    });

    nextBtn?.addEventListener('click', () => {
      const nextKey = keys[(currentIdx + 1) % keys.length];
      updateBoardAndCardData(nextKey);
      openExpandedDiagnosis(laneEjec, false);
    });

    window.addEventListener('keydown', (e) => {
      if (!isExpanded) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        e.stopPropagation();
        closeExpandedDiagnosis();
      }
    });
  }

  initKanbanWipSimulator();
  document.addEventListener('astro:page-load', initKanbanWipSimulator);
</script>
