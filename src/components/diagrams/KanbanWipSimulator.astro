        badgeClass: 'is-alert',
        bottleneck: true,
        magnifiedHtml:
          '<strong>ALERTA DE TOPE WIP (2/2 en Ejecución):</strong> OT-104 bloqueada por patrón fuera de rango. Preparación detiene el empuje hasta resolver.',
