        badgeText: 'Flujo balanceado',
        badgeClass: 'is-ok',
        bottleneck: false,
        magnifiedHtml:
          '<strong>3 órdenes en curso (Límite WIP: 4):</strong> Preparación (2/2 MÁX) · Ejecución (1/2 MÁX, 1 cupo libre) · Completado (1 entregada).',
        counts: { cola: '2 en espera', prep: '2 / 2 MÁX', ejec: '1 / 2 MÁX', done: '1 completada' },
        lanes: {
          cola: [
            { id: 'OT-105', title: 'Ajuste línea B', note: 'Lista para iniciar' },
            { id: 'OT-106', title: 'Inspección válvula', note: 'En turno programado' },
          ],
          prep: [
            { id: 'OT-103', title: 'Kit rodamientos', note: 'Material completo' },
            { id: 'OT-104', title: 'Calibración sensor', note: 'Lista para pasar →' },
          ],
          ejec: [
            { id: 'OT-102', title: 'Cambio sello bomba', note: 'En verificación final' },
          ],
          done: [
            { id: 'OT-101', title: 'Limpieza filtro A', note: 'Cerrada conforme', status: 'done' },
          ],
        },
      },
      avance: {
        tag: 'MOMENTO 02 · AVANCE POR JALÓN (PULL)',
        step: 'Estado 2 de 4',
        title: 'Una actividad avanza solo cuando hay cupo adelante',
        summary:
          'Al completarse OT-102 y pasar a «Completado», se libera capacidad en Ejecución. Esa señal permite jalar OT-104 desde Preparación y, a su vez, abrir espacio para que OT-105 ingrese desde la cola.',
        flowNote:
          'El trabajo se mueve de derecha a izquierda en señales: primero sale una entrega y luego ingresa una nueva tarea.',
        leaderNote:
          'Mantener el ritmo (Takt) observando la salida real de órdenes completadas, no la cantidad de órdenes empezadas.',
        wipTotal: '3 órdenes en curso (Límite WIP: 4)',
        badgeText: 'Avance sincronizado',
        badgeClass: 'is-ok',
        bottleneck: false,
        magnifiedHtml:
          '<strong>Efecto Jalón (Pull):</strong> OT-102 pasa a Completado → libera cupo en Ejecución → entra OT-104 → entra OT-105 a Preparación.',
        counts: { cola: '1 en espera', prep: '2 / 2 MÁX', ejec: '1 / 2 MÁX', done: '2 completadas' },
        lanes: {
          cola: [
            { id: 'OT-106', title: 'Inspección válvula', note: 'Siguiente en cola' },
          ],
          prep: [
            { id: 'OT-103', title: 'Kit rodamientos', note: 'Preparación 80%' },
            { id: 'OT-105', title: 'Ajuste línea B', note: 'Recién jalada →' },
          ],
          ejec: [
            { id: 'OT-104', title: 'Calibración sensor', note: 'En prueba funcional' },
          ],
          done: [
            { id: 'OT-101', title: 'Limpieza filtro A', note: 'Cerrada conforme', status: 'done' },
