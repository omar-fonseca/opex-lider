            { id: 'OT-106', title: 'Inspección válvula', note: 'En preparación' },
          ],
          ejec: [
            { id: 'OT-104', title: 'Calibración sensor', note: 'BLOQUEO: patrón fuera de rango', status: 'blocked' },
            { id: 'OT-103', title: 'Kit rodamientos', note: 'En montaje activo' },
          ],
          done: [
            { id: 'OT-101', title: 'Limpieza filtro A', note: 'Cerrada conforme', status: 'done' },
