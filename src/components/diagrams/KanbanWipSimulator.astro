---
// Página 07 — Tablero Kanban físico digital en 2.8D (EDU-UX-02)
// Notas adhesivas físicas digitales (Amarillo, Rosado, Cian), animaciones espaciales FLIP,
// narrativa operacional rigurosa y trazabilidad real de los 20 lotes (1.000 barras).
---

<div class="expandable-workbench" id="kanban-wip-workbench" data-expanded="false">
  <!-- Cabecera del banco de trabajo con kicker y feedback vivo -->
  <div class="expandable-header">
    <div class="canvas-Topline">
      <div class="kb-header-meta">
        <span class="canvas-kicker">TABLERO FÍSICO DIGITAL 2.8D · FLUJO PULL Y POLÍTICA WIP</span>
        <span class="canvas-hint" id="wip-feedback-banner" role="status" aria-live="polite">
          Haz clic en cualquier nota adhesiva para inspeccionar su orden y trayectoria, o pulsa «Iniciar lote (Jalar)» para avanzar el flujo.
        </span>
      </div>
      <div class="kb-header-actions">
        <button type="button" class="kb-action-btn kb-reset-btn" id="kb-reset-btn" title="Restaurar el pedido al estado inicial (50 barras listas, 950 pendientes)">
          <span aria-hidden="true">↺</span> Reiniciar pedido
        </button>
        <button type="button" class="kb-action-btn kb-history-btn" id="kb-open-tray-btn" aria-haspopup="dialog" title="Consultar el archivo de lotes terminados con trazabilidad completa">
          <span aria-hidden="true">📁</span> Archivo (<span id="tray-count-badge">1</span>)
        </button>
        <button type="button" class="kb-action-btn kb-tech-btn" id="wip-open-detail-btn" aria-haspopup="dialog" title="Abrir análisis técnico profundo del flujo (M1–M4)">
          <span aria-hidden="true">↗</span> Diagnóstico técnico [M1–M4]
        </button>
      </div>
    </div>
  </div>

  <div class="expandable-stage">
    <!-- Lienzo del Tablero Físico en 2.8D -->
    <div class="expandable-canvas-wrap kb-physical-board-wrap" id="kb-physical-board-wrap">

      <!-- Barra superior de telemetría del pedido del cliente: 1.000 barras en 20 lotes de 50 -->
      <div class="kb-order-telemetry" role="region" aria-label="Telemetría del pedido en curso">
        <div class="kb-telemetry-item">
          <span class="kb-telemetry-label">PEDIDO CLIENTE</span>
          <strong class="kb-telemetry-val">1.000 barras</strong>
          <span class="kb-telemetry-sub">20 lotes de 50 barras</span>
        </div>
        <div class="kb-telemetry-divider" aria-hidden="true"></div>
        <div class="kb-telemetry-item">
          <span class="kb-telemetry-label">POR INICIAR (PENDIENTE)</span>
          <strong class="kb-telemetry-val" id="telemetry-pending-bars">950 barras</strong>
          <span class="kb-telemetry-sub" id="telemetry-pending-lots">19 lotes pendientes</span>
        </div>
        <div class="kb-telemetry-divider" aria-hidden="true"></div>
        <div class="kb-telemetry-item">
          <span class="kb-telemetry-label">EN PROCESO (WIP)</span>
          <strong class="kb-telemetry-val" id="telemetry-wip-bars">0 barras</strong>
          <span class="kb-telemetry-sub kb-wip-sub-badge" id="telemetry-wip-badge">0 / 2 lotes MÁX</span>
        </div>
        <div class="kb-telemetry-divider" aria-hidden="true"></div>
        <div class="kb-telemetry-item">
          <span class="kb-telemetry-label">TERMINADAS</span>
          <strong class="kb-telemetry-val kb-val-success" id="telemetry-done-bars">50 barras</strong>
          <span class="kb-telemetry-sub" id="telemetry-done-lots">1 lote entregado</span>
        </div>
      </div>

      <!-- Alerta visual de límite WIP (solo se muestra cuando se intenta sobrepasar 2/2) -->
      <div class="kb-wip-alert-toast" id="kb-wip-alert-toast" role="alert" hidden aria-hidden="true">
        <div class="kb-alert-icon-wrap" aria-hidden="true">⛔</div>
        <div class="kb-alert-body">
          <strong class="kb-alert-headline">RESTRICCIÓN DE CAPACIDAD: TOPE WIP ALCANZADO (2 / 2 LOTES MÁX)</strong>
          <p class="kb-alert-text" id="kb-alert-text">
            La política explícita de esta celda impide iniciar un 3.er lote cuando las 2 estaciones están ocupadas (100 barras en curso). Regla operativa Kanban: <em>«Deja de empezar y empieza a terminar»</em>. Pulsa <strong>«Terminar lote»</strong> en la columna central para liberar 1 cupo Pull.
          </p>
        </div>
        <button type="button" class="kb-alert-dismiss" id="kb-alert-dismiss" aria-label="Cerrar advertencia de límite WIP" title="Cerrar advertencia">✕</button>
      </div>

      <!-- Superficie del Tablero Físico Digital con Columnas y Ranuras -->
      <div class="kb-board-surface" id="kb-board-surface">

        <!-- COLUMNA 1: PENDIENTE (POR INICIAR) -->
        <div class="kb-column" id="kb-col-pending" data-col="pending">
          <div class="kb-column-header">
            <div class="kb-col-title-wrap">
              <span class="kb-col-pill">01</span>
              <h3 class="kb-col-title">Pendiente</h3>
            </div>
            <span class="kb-col-counter" id="col-pending-counter">19 por iniciar (950 barras)</span>
          </div>
          <p class="kb-col-policy-cue">
            Cola de órdenes liberadas. Esperan señal <em>Pull</em> (cupo libre en WIP) antes de ingresar a planta.
          </p>
          <div class="kb-card-slot kb-slot-pending" id="slot-pending" aria-label="Ranura de lotes pendientes">
            <!-- Notas adhesivas visibles al frente de la cola -->
          </div>
          <div class="kb-col-footer-action">
            <button type="button" class="kb-step-btn kb-btn-primary" id="btn-start-lot" title="Jalar el siguiente lote hacia En Proceso">
              <span aria-hidden="true">▶</span> Iniciar lote (Jalar)
            </button>
          </div>
        </div>

        <!-- COLUMNA 2: EN PROCESO (CON LÍMITE WIP ESTRICTO) -->
        <div class="kb-column kb-column-wip" id="kb-col-process" data-col="process">
          <div class="kb-column-header">
            <div class="kb-col-title-wrap">
              <span class="kb-col-pill">02</span>
              <h3 class="kb-col-title">En proceso</h3>
            </div>
            <span class="kb-wip-tag" id="col-wip-tag">WIP: 0 / 2 MÁX</span>
          </div>
          <p class="kb-col-policy-cue">
            Política explícita de esta celda: <strong>máx. 2 lotes activos</strong> (2 estaciones CNC) para evitar colas ocultas.
          </p>
          <div class="kb-cards-stack-slot" id="slot-process" aria-label="Ranura de trabajos en proceso">
            <!-- 2 Ranuras fijas para notas en proceso o espacios disponibles -->
          </div>
          <div class="kb-col-footer-action">
            <button type="button" class="kb-step-btn kb-btn-finish" id="btn-finish-lot" title="Completar lote activo y enviarlo a Terminado">
              <span aria-hidden="true">✓</span> Terminar lote
            </button>
          </div>
        </div>

        <!-- COLUMNA 3: TERMINADO (REGISTRO Y ARCHIVO) -->
        <div class="kb-column" id="kb-col-done" data-col="done">
          <div class="kb-column-header">
            <div class="kb-col-title-wrap">
              <span class="kb-col-pill">03</span>
              <h3 class="kb-col-title">Terminado</h3>
            </div>
            <span class="kb-col-counter" id="col-done-counter">1 completado (50 barras)</span>
          </div>
          <p class="kb-col-policy-cue">
            Lotes liberados con calidad conforme. Cada salida libera 1 cupo WIP y se archiva con trazabilidad total.
          </p>
          <div class="kb-card-slot kb-slot-done" id="slot-done" aria-label="Ranura de última orden terminada">
            <!-- Última nota terminada con sello conforme -->
          </div>
          <div class="kb-col-footer-action">
            <button type="button" class="kb-step-btn kb-btn-tray" id="btn-open-tray-inline" title="Abrir bandeja de archivo histórico">
              <span aria-hidden="true">📁</span> Archivo (<span id="tray-btn-count">1</span>)
            </button>
          </div>
        </div>

      </div>

      <!-- Leyenda de colores físicos (Amarillo, Rosado, Cian) y rigor metodológico Kanban -->
      <div class="kb-board-footer-meta">
        <div class="kb-color-legend" aria-label="Significado de los tres colores de papel de las notas adhesivas">
          <span class="kb-legend-title">CÓDIGO CROMÁTICO DE LA NOTA FÍSICA:</span>
          <div class="kb-legend-item">
            <span class="kb-swatch kb-swatch-yellow" aria-hidden="true"></span>
            <span><strong>Amarillo:</strong> Mecanizado estándar (50 barras)</span>
          </div>
          <div class="kb-legend-item">
            <span class="kb-swatch kb-swatch-pink" aria-hidden="true"></span>
            <span><strong>Rosado:</strong> Prioridad alta / Urgente (50 barras)</span>
          </div>
          <div class="kb-legend-item">
            <span class="kb-swatch kb-swatch-cyan" aria-hidden="true"></span>
            <span><strong>Cian:</strong> Tratamiento e inspección (50 barras)</span>
          </div>
        </div>
        <p class="kb-methodology-note">
          <strong>Nota metodológica:</strong> Un tablero Kanban real modela las etapas específicas de cada proceso (no consta universalmente de 3 columnas) y el límite <strong>WIP = 2</strong> es una política explícita configurada para la capacidad de esta celda, no una constante fija.
        </p>
      </div>

    </div>

    <!-- Velo semitransparente con desenfoque suave para inspección flotante -->
    <div class="kb-floating-scrim" id="kb-floating-scrim" aria-hidden="true" hidden></div>

    <!-- BANDEJA DE TRAZABILIDAD (DRAWER FLOTANTE DE HISTORIAL) -->
    <aside
      class="kb-tray-drawer"
      id="kb-tray-drawer"
      role="dialog"
      aria-modal="true"
      aria-labelledby="tray-drawer-title"
      hidden
      aria-hidden="true"
    >
      <div class="kb-tray-header">
        <div>
          <span class="inspector-tag">REGISTRO DE SALIDAS Y TRAZABILIDAD</span>
          <h3 class="kb-tray-title" id="tray-drawer-title">Archivo de Lotes Terminados</h3>
        </div>
        <button type="button" class="expanded-close-btn" id="kb-tray-close-btn" aria-label="Cerrar archivo de terminados" title="Cerrar (Escape)">
          ✕ Cerrar
        </button>
      </div>
      <p class="kb-tray-desc">
        Trazabilidad completa: cada lote conserva su identificador, color de tarjeta física, tarea ejecutada y sello de liberación. Haz clic en cualquier lote archivado para inspeccionar su ficha.
      </p>
      <div class="kb-tray-summary-bar">
        <span>Total entregado: <strong id="tray-sum-bars">50</strong> barras</span>
        <span>Lotes archivados: <strong id="tray-sum-lots">1</strong> de 20</span>
      </div>
      <div class="kb-tray-list" id="kb-tray-list" role="list" aria-label="Lista histórica de lotes completados">
        <!-- Tarjetas terminadas registradas dinámicamente -->
      </div>
    </aside>

    <!-- INSPECTOR DETALLADO DE NOTA ADHESIVA (APERTURA ESPACIAL FLIP + IDENTIDAD CROMÁTICA) -->
    <aside
      class="kb-note-inspector"
      id="kb-note-inspector"
      role="dialog"
      aria-modal="true"
      aria-labelledby="note-inspector-title"
      data-note-color="yellow"
      hidden
      aria-hidden="true"
    >
      <div class="kb-note-inspector-header">
        <div>
          <span class="inspector-tag" id="note-insp-tag">TARJETA KANBAN · LOT-02</span>
          <h3 class="kb-tray-title" id="note-inspector-title">Detalle de la Orden de Producción</h3>
        </div>
        <button type="button" class="expanded-close-btn" id="kb-note-close-btn" aria-label="Cerrar detalle de la nota" title="Cerrar (Escape)">
          ✕ Cerrar
        </button>
      </div>

      <div class="kb-note-inspector-body">
        <div class="kb-note-preview-row">
          <div class="kb-note-card-preview" id="note-insp-preview">
            <!-- Vista previa táctil de la nota física -->
          </div>
          <div class="kb-note-operational-context">
            <span class="kb-context-kicker" id="note-insp-color-label">PAPEL AMARILLO · MECANIZADO ESTÁNDAR</span>
            <p class="kb-context-spec" id="note-insp-spec-desc">
              Corte cilíndrico de barras Ø50 mm en torno CNC bajo tolerancia ±0.02 mm.
            </p>
            <div class="kb-context-meaning" id="note-insp-stage-meaning">
              <!-- Explicación contextual de su estado actual -->
            </div>
          </div>
        </div>

        <div class="kb-note-spec-grid">
          <div class="inspector-detail-box">
            <span>CANTIDAD DEL LOTE</span>
            <strong id="note-insp-qty">50 barras de acero</strong>
          </div>
          <div class="inspector-detail-box">
            <span>FAMILIA / SEÑAL DE COLOR</span>
            <strong id="note-insp-type">Mecanizado estándar (Amarillo)</strong>
          </div>
          <div class="inspector-detail-box">
            <span>ESTADO EN EL FLUJO</span>
            <strong id="note-insp-status">En cola (Pendiente)</strong>
          </div>
          <div class="inspector-detail-box">
            <span>ESTÁNDAR TÉCNICO Y CICLO</span>
            <strong id="note-insp-cycle">Tolerancia ±0.02 mm · 45 min/lote</strong>
          </div>
        </div>

        <div class="kb-trajectory-box">
          <span class="kb-trajectory-label">TRAYECTORIA Y TRAZABILIDAD DEL LOTE EN EL PROCESO:</span>
          <div class="kb-trajectory-steps" id="note-insp-trajectory">
            <!-- Pasos de trayectoria -->
          </div>
        </div>

        <div class="expanded-leader-box">
          <div class="leader-box-header">
            <span class="leader-box-icon" aria-hidden="true">💡</span>
            <span class="leader-box-title">FUNCIÓN DE LA TARJETA KANBAN EN PLANTA</span>
          </div>
          <p class="leader-box-quote">
            «En la nota adhesiva física sólo escribimos lo esencial para leer el flujo a tres metros de distancia (lote, tarea corta, cantidad y estado). Al acercarnos a inspeccionar la orden, verificamos su especificación técnica, la política WIP de la estación y su historial completo.»
          </p>
        </div>
      </div>
    </aside>

    <!-- Modal Editorial FLIP Existente para diagnóstico técnico profundo (M1–M4) -->
    <div class="expandable-scrim" id="wip-stage-scrim" aria-hidden="true" title="Cerrar diagnóstico ampliado"></div>
    <aside
      class="expanded-editorial-card"
      id="wip-inspector"
      role="dialog"
      aria-modal="false"
      aria-labelledby="wip-title"
      aria-hidden="true"
      hidden
    >
      <div class="expanded-topbar">
        <div class="inspector-badge-row" style="margin-bottom: 0;">
          <span class="inspector-tag" id="wip-tag">MOMENTO 01 · FLUJO BALANCEADO</span>
          <span class="inspector-step-indicator" id="wip-step">Estado 1 de 4</span>
        </div>

        <button
          type="button"
          class="expanded-close-btn"
          id="wip-close-btn"
          aria-label="Cerrar diagnóstico ampliado y regresar al tablero Kanban"
          title="Cerrar (Escape)"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          <span>Cerrar</span>
        </button>
      </div>

      <div class="expanded-body">
        <div class="stage-selector-bar" role="tablist" aria-label="Momentos del flujo técnico M1 a M4">
          <button type="button" class="stage-pill-btn is-active" role="tab" aria-selected="true" data-wip-state="estable">
            <span class="stage-pill-num">M1</span> Flujo estable
          </button>
          <button type="button" class="stage-pill-btn" role="tab" aria-selected="false" data-wip-state="avance">
            <span class="stage-pill-num">M2</span> Avance por jalón
          </button>
          <button type="button" class="stage-pill-btn" role="tab" aria-selected="false" data-wip-state="restriccion">
            <span class="stage-pill-num">M3</span> Restricción y tope WIP
          </button>
          <button type="button" class="stage-pill-btn" role="tab" aria-selected="false" data-wip-state="desbloqueo">
            <span class="stage-pill-num">M4</span> Desbloqueo del flujo
          </button>
        </div>

        <div class="expanded-magnified-box">
          <div class="expanded-magnified-head">
            <span class="expanded-magnified-label" id="wip-magnified-label">LECTURA DE CAPACIDAD Y WIP EN EL TABLERO</span>
            <span class="status-badge is-ok" id="wip-magnified-badge">Flujo balanceado</span>
          </div>
          <div class="expanded-magnified-copy" id="wip-magnified-copy">
            <strong>Capacidad balanceada:</strong> 1 lote completado (50 barras) · hasta 2 lotes en proceso (100 barras) · cola sincronizada por jalón.
          </div>
        </div>

        <div>
          <h3 class="expanded-title" id="wip-title">El trabajo en curso (WIP) bajo control</h3>
          <p class="expanded-summary" id="wip-summary">
            Cada etapa del proceso tiene un número máximo de actividades permitidas al mismo tiempo (límite WIP). Cuando el equipo respeta ese tope, cada orden avanza sin colas ocultas ni cambios constantes de prioridad.
          </p>
        </div>

        <div class="expanded-details-grid">
          <div class="inspector-detail-box">
            <span>¿QUÉ OCURRE EN EL FLUJO?</span>
            <p id="wip-flow-note">
              Pendiente mantiene la cola ordenada; En proceso respeta estrictamente el tope configurado de 2 lotes simultáneos.
            </p>
          </div>
          <div class="inspector-detail-box">
            <span>ACCIÓN DEL LÍDER</span>
            <p id="wip-leader-note">
              Supervisar que nadie inicie un tercer lote en la celda hasta que una estación termine su orden y libere un cupo Pull.
            </p>
          </div>
        </div>

        <div class="expanded-footer-nav">
          <button type="button" class="step-nav-btn" id="wip-prev-btn" aria-label="Ver momento anterior del flujo">
            ← Momento anterior
          </button>
          <button type="button" class="expanded-return-btn" id="wip-return-btn">
            Volver al simulador Kanban
          </button>
          <button type="button" class="step-nav-btn" id="wip-next-btn" aria-label="Ver siguiente momento del flujo">
            Siguiente momento →
          </button>
        </div>
      </div>
    </aside>

  </div>
</div>

<style is:global>
  /* =========================================================================
     ESTILOS DEL TABLERO FÍSICO DIGITAL 2.8D (EDU-UX-02)
     Acotados estrictamente a #kanban-wip-workbench para aplicar tanto al HTML
     estático como a las notas adhesivas creadas dinámicamente en el DOM.
     ========================================================================= */

  #kanban-wip-workbench .kb-wip-alert-toast[hidden],
  #kanban-wip-workbench .kb-floating-scrim[hidden],
  #kanban-wip-workbench .kb-tray-drawer[hidden],
  #kanban-wip-workbench .kb-note-inspector[hidden],
  #kanban-wip-workbench .expanded-editorial-card[hidden],
  #kanban-wip-workbench .expandable-scrim[hidden] {
    display: none !important;
  }

  #kanban-wip-workbench .kb-physical-board-wrap {
    position: relative;
    padding: 24px;
    background:
      radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.08), transparent 65%),
      linear-gradient(180deg, rgba(15, 23, 42, 0.96) 0%, rgba(9, 15, 29, 0.99) 100%);
    border: 1px solid var(--line, #1e293b);
    border-radius: 16px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      inset 0 2px 10px rgba(0, 0, 0, 0.45);
    min-height: 560px;
  }

  html[data-theme="light"] #kanban-wip-workbench .kb-physical-board-wrap {
    background:
      radial-gradient(circle at 50% 0%, rgba(14, 165, 233, 0.07), transparent 65%),
      linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    border-color: #cbd5e1;
    box-shadow: inset 0 2px 6px rgba(15, 23, 42, 0.04);
  }

  /* Acciones de la cabecera */
  #kanban-wip-workbench .kb-header-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #kanban-wip-workbench .kb-header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  #kanban-wip-workbench .kb-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 7px 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    background: var(--surface-card, #0f172a);
    border: 1px solid var(--line, #334155);
    color: var(--text-secondary, #94a3b8);
  }

  #kanban-wip-workbench .kb-action-btn:hover {
    border-color: var(--accent-strong, #38bdf8);
    color: var(--text-primary, #f8fafc);
    transform: translateY(-1px);
  }

  #kanban-wip-workbench .kb-action-btn:focus-visible {
    outline: 2px solid var(--accent-strong, #38bdf8);
    outline-offset: 2px;
  }

  html[data-theme="light"] #kanban-wip-workbench .kb-action-btn {
    background: #ffffff;
    border-color: #cbd5e1;
    color: #334155;
  }

  html[data-theme="light"] #kanban-wip-workbench .kb-action-btn:hover {
    border-color: var(--accent-strong, #0284c7);
    color: #0f172a;
    background: #f1f5f9;
  }

  #kanban-wip-workbench .kb-history-btn {
    border-color: var(--accent-border, rgba(56, 189, 248, 0.45));
    color: var(--accent-text, #38bdf8);
  }

  /* Telemetría superior del pedido */
  #kanban-wip-workbench .kb-order-telemetry {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    background: rgba(15, 23, 42, 0.82);
    border: 1px solid var(--line, #334155);
    border-radius: 12px;
    padding: 12px 18px;
    margin-bottom: 18px;
    backdrop-filter: blur(8px);
  }

  html[data-theme="light"] #kanban-wip-workbench .kb-order-telemetry {
    background: #ffffff;
    border-color: #cbd5e1;
    box-shadow: 0 4px 10px -2px rgba(15, 23, 42, 0.06);
  }

  #kanban-wip-workbench .kb-telemetry-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  #kanban-wip-workbench .kb-telemetry-label {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
