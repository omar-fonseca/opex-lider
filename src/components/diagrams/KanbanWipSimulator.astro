<script>
  import { animateFlipOpen, animateFlipClose } from '../../lib/expandableCardEngine';

  // Motor interactivo del Tablero Kanban Físico Digital 2.8D (EDU-UX-02)
  // Tres colores de nota física (Amarillo, Rosado, Cian), trazabilidad real y apertura FLIP

  interface KanbanLot {
    id: string;             // ej. 'LOT-01'
    lotNumber: number;      // 1 a 20
    bars: number;           // 50
    workType: 'standard' | 'urgent' | 'quality';
    workTypeName: string;   // 'Mecanizado estándar' | 'Prioridad alta / Urgente' | 'Tratamiento e inspección'
    colorKey: 'yellow' | 'pink' | 'cyan';
    colorLabel: string;     // 'Amarilla' | 'Rosada' | 'Cian'
    paperLabel: string;     // 'Amarillo' | 'Rosado' | 'Cian'
    colorClass: 'kb-note-yellow' | 'kb-note-pink' | 'kb-note-cyan';
    shortTask: string;      // Tarea corta visible en la cara de la nota adhesiva
    taskTitle: string;      // Título completo para el inspector
    taskDesc: string;       // Especificación técnica extendida
    cycleSpec: string;      // Tolerancia y tiempo de ciclo
    status: 'pending' | 'process' | 'done';
    completedTimestamp?: string;
  }

  const TOTAL_LOTS = 20;
  const BARS_PER_LOT = 50;
  const WIP_LIMIT = 2;

  // Catálogo de 3 familias operacionales y sus 3 colores de papel físico (Amarillo, Rosado, Cian)
  const WORK_TYPES = [
    {
      type: 'standard' as const,
      name: 'Mecanizado estándar',
      colorKey: 'yellow' as const,
      colorLabel: 'Amarilla',
      paperLabel: 'Amarillo',
      colorClass: 'kb-note-yellow' as const,
      shortTask: 'Torneado y rectificado CNC',
      taskTitle: 'Torneado y rectificado de precisión',
      taskDesc: 'Cilindrado y refrentado de barras de acero Ø50 mm en torno CNC bajo control estadístico.',
      cycleSpec: 'Tolerancia ±0.02 mm · Ciclo 45 min',
    },
    {
      type: 'urgent' as const,
      name: 'Prioridad alta / Urgente',
      colorKey: 'pink' as const,
      colorLabel: 'Rosada',
      paperLabel: 'Rosado',
      colorClass: 'kb-note-pink' as const,
      shortTask: 'Fresado CNC y taladrado ejes',
      taskTitle: 'Fresado CNC y taladrado de ejes',
      taskDesc: 'Mecanizado de chaveteros y perforación axial para orden prioritaria de línea de ensamble.',
      cycleSpec: 'Tolerancia ±0.015 mm · Ciclo 50 min',
    },
    {
      type: 'quality' as const,
      name: 'Tratamiento e inspección',
      colorKey: 'cyan' as const,
      colorLabel: 'Cian',
      paperLabel: 'Cian',
      colorClass: 'kb-note-cyan' as const,
      shortTask: 'Temple e inspección Rockwell',
      taskTitle: 'Tratamiento térmico y temple superficial',
      taskDesc: 'Inducción térmica superficial, ensayo de dureza Rockwell C (58–62 HRC) y liberación óptica.',
      cycleSpec: 'Dureza 60 HRC · Inspección 100%',
    },
  ];

  function createLot(lotNumber: number, initialStatus: 'pending' | 'process' | 'done'): KanbanLot {
    const typeDef = WORK_TYPES[(lotNumber - 1) % WORK_TYPES.length];
    const padNum = lotNumber < 10 ? `0${lotNumber}` : `${lotNumber}`;
    return {
      id: `LOT-${padNum}`,
      lotNumber,
      bars: BARS_PER_LOT,
      workType: typeDef.type,
      workTypeName: typeDef.name,
      colorKey: typeDef.colorKey,
      colorLabel: typeDef.colorLabel,
      paperLabel: typeDef.paperLabel,
      colorClass: typeDef.colorClass,
      shortTask: typeDef.shortTask,
      taskTitle: `Lote ${padNum} · ${typeDef.taskTitle}`,
      taskDesc: typeDef.taskDesc,
      cycleSpec: typeDef.cycleSpec,
      status: initialStatus,
      completedTimestamp: initialStatus === 'done' ? 'Turno mañana · 08:30 (Liberado conforme)' : undefined,
    };
  }

  // Momentos M1-M4 para el diagnóstico técnico profundo existente
  const TECHNICAL_MOMENTS: Record<string, {
    tag: string;
    step: string;
    title: string;
    summary: string;
    flowNote: string;
    leaderNote: string;
    badgeText: string;
    badgeClass: string;
    magnifiedHtml: string;
  }> = {
    estable: {
      tag: 'MOMENTO 01 · FLUJO BALANCEADO',
      step: 'Estado 1 de 4',
      title: 'El trabajo en curso (WIP) bajo control',
      summary: 'Cada etapa del proceso tiene un número máximo de actividades permitidas al mismo tiempo (política explícita WIP = 2 en esta celda). Cuando el equipo respeta ese tope, cada orden avanza sin colas ocultas ni cambios constantes de prioridad.',
      flowNote: 'Pendiente mantiene la cola priorizada; En proceso conserva un máximo de 2 lotes activos para proteger las estaciones CNC.',
      leaderNote: 'Supervisar que ningún operador inicie un tercer lote hasta que una estación complete su lote actual y libere el cupo.',
      badgeText: 'Flujo balanceado',
      badgeClass: 'is-ok',
      magnifiedHtml: '<strong>Capacidad balanceada:</strong> 1 lote completado (50 barras) · hasta 2 lotes en proceso (100 barras) · cola sincronizada.',
    },
    avance: {
      tag: 'MOMENTO 02 · AVANCE POR JALÓN (PULL)',
      step: 'Estado 2 de 4',
      title: 'El jalón (Pull): sólo se produce si hay capacidad libre',
      summary: 'El trabajo no se empuja por presión ni estimaciones teóricas: se jala hacia adelante únicamente cuando la estación receptora tiene un espacio disponible dentro de su límite WIP.',
      flowNote: 'Al terminar una orden, se abre una señal Kanban de autorización que habilita jalar el siguiente lote de 50 barras de la cola.',
      leaderNote: 'Proteger la disciplina del jalón: si un puesto se detiene, el puesto anterior no debe seguir acumulando material semielaborado.',
      badgeText: 'Avance controlado',
      badgeClass: 'is-ok',
      magnifiedHtml: '<strong>Señal Pull activa:</strong> La finalización de un lote libera exactamente 1 cupo WIP para jalar la orden siguiente.',
    },
    restriccion: {
      tag: 'MOMENTO 03 · DETECCIÓN DE RESTRICCIÓN Y TOPE WIP',
      step: 'Estado 3 de 4',
      title: 'Cuando el WIP llega a 2/2, la restricción se vuelve visible',
      summary: 'Si la etapa En proceso alcanza 2/2 lotes, el tablero bloquea el ingreso de nuevo trabajo. La regla operativa de Kanban: «Deja de empezar y empieza a terminar».',
      flowNote: 'Al intentar ingresar un tercer lote con WIP 2/2, el sistema dispara la alerta de restricción que impide sobrecargar la celda.',
      leaderNote: 'Acudir de inmediato a la estación bloqueada para resolver el impedimento técnico en lugar de abrir órdenes adicionales.',
      badgeText: 'Tope alcanzado (2/2)',
      badgeClass: 'is-warning',
      magnifiedHtml: '<strong>Restricción activa:</strong> Capacidad WIP completa (2/2). Nadie introduce trabajo nuevo hasta terminar un lote activo.',
    },
    desbloqueo: {
      tag: 'MOMENTO 04 · DESBLOQUEO Y TRAZABILIDAD TOTAL',
      step: 'Estado 4 de 4',
      title: 'Desbloqueo del flujo y archivo con trazabilidad',
      summary: 'Al completar un lote activo, la nota pasa a Terminado conservando su identificador, color y tarea, y queda registrada en el Archivo histórico.',
      flowNote: 'El lote terminado se incorpora al archivo de salidas, el contador de barras completadas sube y el WIP baja de 2/2 a 1/2.',
      leaderNote: 'Revisar la causa del bloqueo durante la reunión operativa frente al tablero para prevenir recurrencias en el turno siguiente.',
      badgeText: 'Flujo restablecido',
      badgeClass: 'is-ok',
      magnifiedHtml: '<strong>Entrega asegurada:</strong> Lote liberado con calidad conforme y cupo WIP disponible para sostener el ritmo.',
    },
  };

  function initKanbanPhysicalBoard() {
    const root = document.getElementById('kanban-wip-workbench');
    if (!root || root.getAttribute('data-kb-initialized') === 'true') return;
    root.setAttribute('data-kb-initialized', 'true');

    // Elementos de telemetría y contadores
    const pendingBarsEl = document.getElementById('telemetry-pending-bars');
    const pendingLotsEl = document.getElementById('telemetry-pending-lots');
    const wipBarsEl = document.getElementById('telemetry-wip-bars');
    const wipBadgeEl = document.getElementById('telemetry-wip-badge');
    const doneBarsEl = document.getElementById('telemetry-done-bars');
    const doneLotsEl = document.getElementById('telemetry-done-lots');

    const colPendingCounter = document.getElementById('col-pending-counter');
    const colProcessEl = document.getElementById('kb-col-process');
    const colWipTag = document.getElementById('col-wip-tag');
    const colDoneCounter = document.getElementById('col-done-counter');
    const feedbackBanner = document.getElementById('wip-feedback-banner');

    // Ranuras de columnas
    const slotPending = document.getElementById('slot-pending');
    const slotProcess = document.getElementById('slot-process');
    const slotDone = document.getElementById('slot-done');

    // Botones de acción del tablero
    const btnStartLot = document.getElementById('btn-start-lot');
    const btnFinishLot = document.getElementById('btn-finish-lot');
    const resetBtn = document.getElementById('kb-reset-btn');

    // Alerta de límite WIP
    const alertToast = document.getElementById('kb-wip-alert-toast');
    const alertDismissBtn = document.getElementById('kb-alert-dismiss');

    // Velo flotante compartido
    const floatingScrim = document.getElementById('kb-floating-scrim');

    // Bandeja de terminados (Tray Drawer)
    const trayDrawer = document.getElementById('kb-tray-drawer');
    const trayCloseBtn = document.getElementById('kb-tray-close-btn');
    const trayList = document.getElementById('kb-tray-list');
    const trayCountBadge = document.getElementById('tray-count-badge');
    const trayBtnCount = document.getElementById('tray-btn-count');
    const traySumBars = document.getElementById('tray-sum-bars');
    const traySumLots = document.getElementById('tray-sum-lots');
    const openTrayBtn = document.getElementById('kb-open-tray-btn');
    const openTrayInlineBtn = document.getElementById('btn-open-tray-inline');

    // Inspector de Nota Adhesiva
    const noteInspector = document.getElementById('kb-note-inspector');
    const noteCloseBtn = document.getElementById('kb-note-close-btn');
    const noteInspTag = document.getElementById('note-insp-tag');
    const noteInspectorTitle = document.getElementById('note-inspector-title');
    const noteInspPreview = document.getElementById('note-insp-preview');
    const noteInspColorLabel = document.getElementById('note-insp-color-label');
    const noteInspSpecDesc = document.getElementById('note-insp-spec-desc');
    const noteInspStageMeaning = document.getElementById('note-insp-stage-meaning');
    const noteInspQty = document.getElementById('note-insp-qty');
    const noteInspType = document.getElementById('note-insp-type');
    const noteInspStatus = document.getElementById('note-insp-status');
    const noteInspCycle = document.getElementById('note-insp-cycle');
    const noteInspTrajectory = document.getElementById('note-insp-trajectory');

    // Diagnóstico técnico M1-M4 (FLIP inspector editorial)
    const openDetailBtn = document.getElementById('wip-open-detail-btn');
    const inspector = document.getElementById('wip-inspector');
    const closeBtn = document.getElementById('wip-close-btn');
    const returnBtn = document.getElementById('wip-return-btn');
    const prevBtn = document.getElementById('wip-prev-btn');
    const nextBtn = document.getElementById('wip-next-btn');
    const scrim = document.getElementById('wip-stage-scrim');

    const pills = Array.from(root.querySelectorAll<HTMLButtonElement>('.stage-pill-btn'));
    const tagEl = document.getElementById('wip-tag');
    const stepEl = document.getElementById('wip-step');
    const titleEl = document.getElementById('wip-title');
    const summaryEl = document.getElementById('wip-summary');
    const flowEl = document.getElementById('wip-flow-note');
    const leaderEl = document.getElementById('wip-leader-note');
    const magBadge = document.getElementById('wip-magnified-badge');
    const magCopy = document.getElementById('wip-magnified-copy');

    const techKeys = ['estable', 'avance', 'restriccion', 'desbloqueo'];
    let techCurrentIdx = 0;

    // Estado interno del pedido de 1.000 barras (20 lotes de 50)
    // Estado inicial: 1 lote terminado (LOT-01, Amarillo), 19 lotes pendientes (LOT-02..LOT-20), 0 en proceso.
    let completedLots: KanbanLot[] = [createLot(1, 'done')];
    let processLots: KanbanLot[] = [];
    let nextLotNumber = 2; // El siguiente en cola es LOT-02 (Rosado), seguido de LOT-03 (Cian)

    let lastActiveTrigger: HTMLElement | null = null;
    let alertTimer: number | null = null;

    function prefersReducedMotion(): boolean {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    // Ejecuta animación FLIP espacial de una nota adhesiva al desplazarse entre columnas
    function animateNoteFlip(element: HTMLElement, firstRect: DOMRect, rotationDeg: number) {
      if (prefersReducedMotion()) return;
      const lastRect = element.getBoundingClientRect();
      const deltaX = firstRect.left - lastRect.left;
      const deltaY = firstRect.top - lastRect.top;

      if (deltaX === 0 && deltaY === 0) return;

      element.classList.add('is-flipping');
      element.style.transform = `translate3d(${deltaX}px, ${deltaY}px, 0) scale(1.04) rotate(${rotationDeg + 2}deg)`;
      element.style.transition = 'none';

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          element.style.transition = 'transform 0.42s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.42s ease';
          element.style.transform = `translate3d(0, 0, 0) scale(1) rotate(${rotationDeg}deg)`;

          const cleanup = () => {
            element.classList.remove('is-flipping');
            element.style.transition = '';
            element.style.transform = `rotate(${rotationDeg}deg)`;
            element.removeEventListener('transitionend', cleanup);
          };
          element.addEventListener('transitionend', cleanup, { once: true });
        });
      });
    }

    // =========================================================================
    // CREACIÓN DE LA NOTA ADHESIVA FÍSICA 2.8D (INFORMACIÓN ESENCIAL ÚNICAMENTE)
    // =========================================================================

    function createNoteElement(lot: KanbanLot, rotationDeg: number): HTMLButtonElement {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `kb-sticky-note ${lot.colorClass}`;
      btn.id = `note-${lot.id}`;
      btn.setAttribute('data-lot-id', lot.id);
      btn.setAttribute('data-note-color', lot.colorKey);
      btn.setAttribute('aria-haspopup', 'dialog');

      const statusText =
        lot.status === 'done'
          ? '✓ TERMINADO'
          : lot.status === 'process'
            ? 'EN PROCESO'
            : 'EN COLA';

      const statusStampClass =
        lot.status === 'done'
          ? 'kb-stamp-done'
          : lot.status === 'process'
            ? 'kb-stamp-process'
            : '';

      btn.setAttribute(
        'aria-label',
        `${lot.id} (${lot.colorLabel}): ${lot.shortTask}, ${lot.bars} barras. Estado: ${statusText}. Pulsa para inspeccionar orden y trayectoria.`
      );
      btn.style.transform = `rotate(${rotationDeg}deg)`;

      // Cara de la nota: únicamente los 4 datos esenciales (ID, tarea corta, cantidad, estado)
      btn.innerHTML = `
        <div class="kb-note-head">
          <span class="kb-note-id">${lot.id}</span>
          <span class="kb-note-status-stamp ${statusStampClass}">${statusText}</span>
        </div>
        <h4 class="kb-note-title">${lot.shortTask}</h4>
        <div class="kb-note-foot">
          <span class="kb-note-qty">${lot.bars} barras</span>
          <span class="kb-note-inspect-cue" aria-hidden="true">Ficha ↗</span>
        </div>
      `;

      btn.addEventListener('click', () => {
        lastActiveTrigger = btn;
        openNoteInspector(lot, btn);
      });

      return btn;
    }

    // =========================================================================
    // RENDERIZADO DEL ESTADO COMPLETO DEL TABLERO
    // =========================================================================

    function renderBoardState() {
      const pendingLotsCount = TOTAL_LOTS - completedLots.length - processLots.length;
      const pendingBars = pendingLotsCount * BARS_PER_LOT;
      const wipBars = processLots.length * BARS_PER_LOT;
      const doneBars = completedLots.length * BARS_PER_LOT;

      // Actualizar Telemetría Superior
      if (pendingBarsEl) pendingBarsEl.textContent = `${pendingBars.toLocaleString('es-CO')} barras`;
      if (pendingLotsEl) pendingLotsEl.textContent = `${pendingLotsCount} lote${pendingLotsCount === 1 ? '' : 's'} pendiente${pendingLotsCount === 1 ? '' : 's'}`;
      if (wipBarsEl) wipBarsEl.textContent = `${wipBars} barras`;
      if (wipBadgeEl) {
        wipBadgeEl.textContent = `${processLots.length} / ${WIP_LIMIT} lotes MÁX`;
        wipBadgeEl.style.color = processLots.length >= WIP_LIMIT ? '#ef4444' : 'var(--accent-text)';
      }
      if (doneBarsEl) doneBarsEl.textContent = `${doneBars.toLocaleString('es-CO')} barras`;
      if (doneLotsEl) {
        doneLotsEl.textContent = `${completedLots.length} lote${completedLots.length === 1 ? '' : 's'} entregado${completedLots.length === 1 ? '' : 's'}`;
      }

      // Actualizar Encabezados de Columna
      if (colPendingCounter) {
        colPendingCounter.textContent = `${pendingLotsCount} por iniciar (${pendingBars} barras)`;
      }
      if (colProcessEl) {
        colProcessEl.classList.toggle('is-wip-full', processLots.length >= WIP_LIMIT);
      }
      if (colWipTag) {
        colWipTag.textContent = `WIP: ${processLots.length} / ${WIP_LIMIT} MÁX`;
        if (processLots.length >= WIP_LIMIT) {
          colWipTag.style.borderColor = '#ef4444';
          colWipTag.style.color = '#ef4444';
        } else {
          colWipTag.style.borderColor = '';
          colWipTag.style.color = '';
        }
      }
      if (colDoneCounter) {
        colDoneCounter.textContent = `${completedLots.length} completado${completedLots.length === 1 ? '' : 's'} (${doneBars} barras)`;
      }

      // Actualizar Botones y Badges de Archivo
      if (trayCountBadge) trayCountBadge.textContent = String(completedLots.length);
      if (trayBtnCount) trayBtnCount.textContent = String(completedLots.length);
      if (traySumBars) traySumBars.textContent = doneBars.toLocaleString('es-CO');
      if (traySumLots) traySumLots.textContent = String(completedLots.length);

      // COLUMNA 1: PENDIENTE (muestra los 2 primeros lotes físicos de la cola + indicador del resto)
      if (slotPending) {
        slotPending.innerHTML = '';
        if (nextLotNumber <= TOTAL_LOTS) {
          const visibleQueueCount = Math.min(2, TOTAL_LOTS - nextLotNumber + 1);
          for (let offset = 0; offset < visibleQueueCount; offset++) {
            const lotNum = nextLotNumber + offset;
            const pendingLot = createLot(lotNum, 'pending');
            const tilt = offset === 0 ? -1.1 : 1.2;
            const noteBtn = createNoteElement(pendingLot, tilt);
            slotPending.appendChild(noteBtn);
          }

          const remainingBehind = pendingLotsCount - visibleQueueCount;
          if (remainingBehind > 0) {
            const firstHiddenNum = nextLotNumber + visibleQueueCount;
            const padFirst = firstHiddenNum < 10 ? `0${firstHiddenNum}` : `${firstHiddenNum}`;
            const stackCue = document.createElement('div');
            stackCue.className = 'kb-stack-cue';
            stackCue.innerHTML = `
              <span>En cola detrás: <strong>LOT-${padFirst}</strong> al <strong>LOT-20</strong></span>
              <span>+${remainingBehind} lotes (${remainingBehind * BARS_PER_LOT} barras)</span>
            `;
            slotPending.appendChild(stackCue);
          }
        } else {
          const emptyCue = document.createElement('div');
          emptyCue.className = 'kb-empty-wip-slot';
          emptyCue.innerHTML = `
            <span>✓ Toda la cola ha sido jalada</span>
            <small>0 lotes pendientes por iniciar</small>
          `;
          slotPending.appendChild(emptyCue);
        }
      }

      // COLUMNA 2: EN PROCESO (WIP con límite máximo de 2 ranuras)
      if (slotProcess) {
        slotProcess.innerHTML = '';
        processLots.forEach((lot, i) => {
          const rot = i === 0 ? 0.9 : -1.3;
          const noteBtn = createNoteElement(lot, rot);
          slotProcess.appendChild(noteBtn);
        });

        // Ranuras libres hasta completar WIP_LIMIT = 2
        const freeSlots = WIP_LIMIT - processLots.length;
        for (let i = 0; i < freeSlots; i++) {
          const stationIdx = processLots.length + i + 1;
          const emptySlot = document.createElement('div');
          emptySlot.className = 'kb-empty-wip-slot';
          emptySlot.innerHTML = `
            <span>Estación CNC 0${stationIdx} · Cupo WIP disponible (${stationIdx} de ${WIP_LIMIT})</span>
            <small>Señal Pull activa: listo para jalar 1 lote de 50 barras</small>
          `;
          slotProcess.appendChild(emptySlot);
        }
      }

      // COLUMNA 3: TERMINADO (muestra hasta los 2 últimos lotes completados; todos viven en Archivo)
      if (slotDone) {
        slotDone.innerHTML = '';
        if (completedLots.length > 0) {
          const recentDone = completedLots.slice(-2).reverse();
          recentDone.forEach((lot, idx) => {
            const rot = idx === 0 ? 0.8 : -1.0;
            const noteBtn = createNoteElement(lot, rot);
            slotDone.appendChild(noteBtn);
          });
        }
      }

      // Habilitación de botones de acción
      if (btnStartLot) {
        (btnStartLot as HTMLButtonElement).disabled = nextLotNumber > TOTAL_LOTS;
      }
      if (btnFinishLot) {
        (btnFinishLot as HTMLButtonElement).disabled = processLots.length === 0;
      }
    }

    // =========================================================================
    // GESTIÓN DE ACCIONES: INICIAR (JALAR), TERMINAR Y REINICIAR
    // =========================================================================

    function showWipAlert() {
      if (!alertToast) return;
      alertToast.hidden = false;
      alertToast.setAttribute('aria-hidden', 'false');

      if (feedbackBanner) {
        feedbackBanner.textContent =
          '⛔ Límite WIP alcanzado (2 / 2 lotes). La política de la celda bloquea un 3.er lote: termina primero un lote activo.';
      }

      if (alertTimer) window.clearTimeout(alertTimer);
      alertTimer = window.setTimeout(() => {
        hideWipAlert();
      }, 8000);
    }

    function hideWipAlert() {
      if (!alertToast) return;
      alertToast.hidden = true;
      alertToast.setAttribute('aria-hidden', 'true');
      if (alertTimer) {
        window.clearTimeout(alertTimer);
        alertTimer = null;
      }
    }

    function startNextLot() {
      // 1. Comprobar si se excede el límite WIP = 2
      if (processLots.length >= WIP_LIMIT) {
        showWipAlert();
        return;
      }

      hideWipAlert();

      if (nextLotNumber > TOTAL_LOTS) {
        if (feedbackBanner) {
          feedbackBanner.textContent = 'Todo el pedido de 1.000 barras ya ha sido iniciado.';
        }
        return;
      }

      // Guardar posición origen de la nota frontal para FLIP
      const padNext = nextLotNumber < 10 ? `0${nextLotNumber}` : `${nextLotNumber}`;
      const sourceNoteEl = slotPending?.querySelector(`#note-LOT-${padNext}`) as HTMLElement | null;
      const firstRect = sourceNoteEl ? sourceNoteEl.getBoundingClientRect() : null;

      // Crear el lote en proceso preservando su identificador, color de papel y tarea
      const newLot = createLot(nextLotNumber, 'process');
      processLots.push(newLot);
      nextLotNumber++;

      const remainingPending = TOTAL_LOTS - completedLots.length - processLots.length;
      if (feedbackBanner) {
        feedbackBanner.textContent = `Señal Pull ejecutada: ${newLot.id} (Nota ${newLot.colorLabel}) ingresa a En Proceso (${processLots.length}/${WIP_LIMIT} WIP). Quedan ${remainingPending} lotes en cola.`;
      }

      renderBoardState();

      if (firstRect) {
        const destEl = slotProcess?.querySelector(`#note-${newLot.id}`) as HTMLElement | null;
        if (destEl) {
          animateNoteFlip(destEl, firstRect, processLots.length === 1 ? 0.9 : -1.3);
        }
      }
    }

    function finishFirstLot() {
      if (processLots.length === 0) {
        if (feedbackBanner) {
          feedbackBanner.textContent = 'No hay lotes en proceso para terminar. Pulsa «Iniciar lote (Jalar)» primero.';
        }
        return;
      }

      hideWipAlert();

      const finishedLot = processLots.shift()!;
      finishedLot.status = 'done';
      finishedLot.completedTimestamp = `Orden #${completedLots.length + 1} archivada · Inspección 100% conforme`;

      // Guardar posición origen para FLIP
      const sourceNoteEl = slotProcess?.querySelector(`#note-${finishedLot.id}`) as HTMLElement | null;
      const firstRect = sourceNoteEl ? sourceNoteEl.getBoundingClientRect() : null;

      completedLots.push(finishedLot);

      if (feedbackBanner) {
        feedbackBanner.textContent = `✓ ${finishedLot.id} (Nota ${finishedLot.colorLabel}) terminado y registrado en Archivo (${completedLots.length * BARS_PER_LOT} barras listas). Se liberó 1 cupo WIP (${processLots.length}/${WIP_LIMIT}).`;
      }

      renderBoardState();

      if (firstRect) {
        const destEl = slotDone?.querySelector(`#note-${finishedLot.id}`) as HTMLElement | null;
        if (destEl) {
          animateNoteFlip(destEl, firstRect, 0.8);
        }
      }
    }

    function resetSimulation() {
      completedLots = [createLot(1, 'done')];
      processLots = [];
      nextLotNumber = 2;
      hideWipAlert();
      closeTray();
      closeNoteInspector(false);

      if (feedbackBanner) {
        feedbackBanner.textContent =
          'Pedido reiniciado: 1 lote terminado (LOT-01, 50 barras), 19 lotes pendientes (950 barras), 0 en proceso (WIP 0/2).';
      }

      renderBoardState();
    }

    // =========================================================================
    // BANDEJA DE TRAZABILIDAD (DRAWER DE ARCHIVO CON COLOR E INSPECCIÓN)
    // =========================================================================

    function openTray() {
      if (!trayDrawer || !trayList) return;
      trayList.innerHTML = '';

      completedLots
        .slice()
        .reverse()
        .forEach((lot) => {
          const item = document.createElement('button');
          item.type = 'button';
          item.className = 'kb-tray-item';
          item.setAttribute('role', 'listitem');
          item.setAttribute('data-archived-lot', lot.id);

          const swatchClass =
            lot.colorKey === 'yellow'
              ? 'kb-swatch-yellow'
              : lot.colorKey === 'pink'
                ? 'kb-swatch-pink'
                : 'kb-swatch-cyan';

          item.innerHTML = `
            <div class="kb-tray-item-left">
              <span class="kb-tray-item-id">
                <span class="kb-swatch ${swatchClass}" aria-hidden="true"></span>
                <span>✓ ${lot.id} · ${lot.shortTask}</span>
              </span>
              <span class="kb-tray-item-meta">Nota ${lot.colorLabel} · ${lot.workTypeName} · ${lot.completedTimestamp || 'Calidad conforme'}</span>
            </div>
            <strong class="kb-tray-item-qty">${lot.bars} barras ↗</strong>
          `;

          item.addEventListener('click', () => {
            trayDrawer.hidden = true;
            trayDrawer.setAttribute('aria-hidden', 'true');
            lastActiveTrigger = item;
            openNoteInspector(lot, item);
          });

          trayList.appendChild(item);
        });

      trayDrawer.hidden = false;
      trayDrawer.setAttribute('aria-hidden', 'false');
      if (floatingScrim) {
        floatingScrim.hidden = false;
        floatingScrim.setAttribute('aria-hidden', 'false');
      }

      trayCloseBtn?.focus();
    }

    function closeTray() {
      if (!trayDrawer) return;
      trayDrawer.hidden = true;
      trayDrawer.setAttribute('aria-hidden', 'true');

      if (noteInspector?.hidden) {
        if (floatingScrim) {
          floatingScrim.hidden = true;
          floatingScrim.setAttribute('aria-hidden', 'true');
        }
      }

      if (lastActiveTrigger && document.body.contains(lastActiveTrigger)) {
        lastActiveTrigger.focus();
      } else {
        openTrayBtn?.focus();
      }
    }

    // =========================================================================
    // INSPECTOR DE DETALLE Y TRAYECTORIA DE NOTA ADHESIVA (APERTURA FLIP)
    // =========================================================================

    function openNoteInspector(lot: KanbanLot, originEl?: HTMLElement | null) {
      if (!noteInspector) return;

      noteInspector.setAttribute('data-note-color', lot.colorKey);

      if (noteInspTag) noteInspTag.textContent = `TARJETA KANBAN · ${lot.id} · NOTA ${lot.colorLabel.toUpperCase()}`;
      if (noteInspectorTitle) noteInspectorTitle.textContent = lot.taskTitle;
      if (noteInspColorLabel) {
        noteInspColorLabel.textContent = `PAPEL ${lot.paperLabel.toUpperCase()} · ${lot.workTypeName.toUpperCase()}`;
      }
      if (noteInspSpecDesc) noteInspSpecDesc.textContent = lot.taskDesc;
      if (noteInspQty) noteInspQty.textContent = `${lot.bars} barras de acero mecanizadas`;
      if (noteInspType) noteInspType.textContent = `${lot.workTypeName} (Nota ${lot.colorLabel})`;
      if (noteInspCycle) noteInspCycle.textContent = lot.cycleSpec;

      if (noteInspStatus) {
        noteInspStatus.textContent =
          lot.status === 'done'
            ? 'Terminado y registrado en Archivo'
            : lot.status === 'process'
              ? `En proceso activo (WIP ${processLots.length}/${WIP_LIMIT})`
              : 'En cola de espera (Pendiente de señal Pull)';
      }

      if (noteInspStageMeaning) {
        if (lot.status === 'pending') {
          noteInspStageMeaning.innerHTML =
            '<strong>Por qué espera en Pendiente:</strong> La orden está liberada, pero no ingresa al taller hasta que exista un cupo WIP disponible en las estaciones CNC (sistema <em>Pull</em>).';
        } else if (lot.status === 'process') {
          noteInspStageMeaning.innerHTML =
            '<strong>Qué significa En Proceso (WIP):</strong> Este lote ocupa actualmente 1 de los 2 cupos máximos autorizados en la celda. Ningún lote nuevo desplazará su prioridad hasta que termine.';
        } else {
          noteInspStageMeaning.innerHTML =
            '<strong>Trazabilidad en Terminado / Archivo:</strong> El lote completó su mecanizado e inspección, liberó 1 cupo WIP aguas arriba y quedó archivado con su código y color de origen.';
        }
      }

      // Vista previa táctil de la nota física
      if (noteInspPreview) {
        noteInspPreview.innerHTML = '';
        const previewNote = createNoteElement(lot, -1.0);
        previewNote.removeAttribute('id');
        previewNote.style.cursor = 'default';
        previewNote.tabIndex = -1;
        noteInspPreview.appendChild(previewNote);
      }

      // Trayectoria dinámica
      if (noteInspTrajectory) {
        const isDone = lot.status === 'done';
        const isProc = lot.status === 'process';

        noteInspTrajectory.innerHTML = `
          <div class="kb-traj-step ${isProc || isDone ? 'is-done' : 'is-current'}">
            <span class="kb-traj-icon">${isProc || isDone ? '✓' : '1'}</span>
            <span><strong>01 · Pendiente (Cola Pull):</strong> Orden física ${lot.id} (${lot.bars} barras) preparada ${isProc || isDone ? 'y jalada a planta' : 'esperando cupo WIP libre'}.</span>
          </div>
          <div class="kb-traj-step ${isDone ? 'is-done' : isProc ? 'is-current' : ''}">
            <span class="kb-traj-icon">${isDone ? '✓' : isProc ? '▶' : '2'}</span>
            <span><strong>02 · En proceso (Política WIP ≤ 2):</strong> ${lot.shortTask} en celda CNC ${isDone ? '(Completado)' : isProc ? '(En ejecución activa)' : '(Pendiente de ingreso)'}.</span>
          </div>
          <div class="kb-traj-step ${isDone ? 'is-done' : ''}">
            <span class="kb-traj-icon">${isDone ? '✓' : '3'}</span>
            <span><strong>03 · Terminado y Archivo:</strong> Inspección final (${lot.cycleSpec}) y registro histórico ${isDone ? '✓ Aprobado y archivado' : '(Pendiente)'}.</span>
          </div>
        `;
      }

      noteInspector.hidden = false;
      noteInspector.setAttribute('aria-hidden', 'false');
      if (floatingScrim) {
        floatingScrim.hidden = false;
        floatingScrim.setAttribute('aria-hidden', 'false');
      }

      if (originEl && document.body.contains(originEl)) {
        animateFlipOpen(originEl, noteInspector, { durationOpen: 360 });
      }

      noteCloseBtn?.focus({ preventScroll: true });
    }

    function closeNoteInspector(animate = true) {
      if (!noteInspector || noteInspector.hidden) return;

      const finalizeClose = () => {
        noteInspector.hidden = true;
        noteInspector.setAttribute('aria-hidden', 'true');

        if (trayDrawer?.hidden) {
          if (floatingScrim) {
            floatingScrim.hidden = true;
            floatingScrim.setAttribute('aria-hidden', 'true');
          }
        }

        if (lastActiveTrigger && document.body.contains(lastActiveTrigger)) {
          lastActiveTrigger.focus({ preventScroll: true });
        }
      };

      const currentBoardNote =
        lastActiveTrigger && document.body.contains(lastActiveTrigger)
          ? lastActiveTrigger
          : null;

      if (animate && currentBoardNote) {
        animateFlipClose(currentBoardNote, noteInspector, finalizeClose, { durationClose: 250 });
      } else {
        finalizeClose();
      }
    }

    // =========================================================================
    // DIAGNÓSTICO TÉCNICO PROFUNDO M1–M4 (MODAL FLIP EXISTENTE)
    // =========================================================================

    function updateTechMoment(key: string) {
      const idx = techKeys.indexOf(key);
      if (idx === -1) return;
      techCurrentIdx = idx;
      const m = TECHNICAL_MOMENTS[key];

      pills.forEach((p) => {
        const active = p.getAttribute('data-wip-state') === key;
        p.classList.toggle('is-active', active);
        p.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      if (tagEl) tagEl.textContent = m.tag;
      if (stepEl) stepEl.textContent = m.step;
      if (titleEl) titleEl.textContent = m.title;
      if (summaryEl) summaryEl.textContent = m.summary;
      if (flowEl) flowEl.textContent = m.flowNote;
      if (leaderEl) leaderEl.textContent = m.leaderNote;
      if (magBadge) {
        magBadge.textContent = m.badgeText;
        magBadge.className = `status-badge ${m.badgeClass}`;
      }
      if (magCopy) magCopy.innerHTML = m.magnifiedHtml;
    }

    function openTechDiagnosis() {
      if (!inspector) return;
      root.setAttribute('data-expanded', 'true');
      inspector.hidden = false;
      inspector.setAttribute('aria-hidden', 'false');
      scrim?.setAttribute('aria-hidden', 'false');

      updateTechMoment(techKeys[techCurrentIdx]);
      if (openDetailBtn) {
        animateFlipOpen(openDetailBtn, inspector, { durationOpen: 360 });
      }
      setTimeout(() => closeBtn?.focus({ preventScroll: true }), 60);
    }

    function closeTechDiagnosis() {
      if (!inspector || inspector.hidden) return;
      const finish = () => {
        root.setAttribute('data-expanded', 'false');
        inspector.hidden = true;
        inspector.setAttribute('aria-hidden', 'true');
        scrim?.setAttribute('aria-hidden', 'true');
        openDetailBtn?.focus({ preventScroll: true });
      };
      if (openDetailBtn) {
        animateFlipClose(openDetailBtn, inspector, finish, { durationClose: 250 });
      } else {
        finish();
      }
    }

    // =========================================================================
    // EVENT LISTENERS DEL TABLERO
    // =========================================================================

    btnStartLot?.addEventListener('click', startNextLot);
    btnFinishLot?.addEventListener('click', finishFirstLot);
    resetBtn?.addEventListener('click', resetSimulation);
    alertDismissBtn?.addEventListener('click', hideWipAlert);

    // Apertura y cierre de Bandeja de Trazabilidad
    openTrayBtn?.addEventListener('click', () => {
      lastActiveTrigger = openTrayBtn;
      openTray();
    });
    openTrayInlineBtn?.addEventListener('click', () => {
      lastActiveTrigger = openTrayInlineBtn;
      openTray();
    });
    trayCloseBtn?.addEventListener('click', closeTray);

    // Cierre del inspector de notas
    noteCloseBtn?.addEventListener('click', () => closeNoteInspector(true));

    // Clic fuera en el velo flotante
    floatingScrim?.addEventListener('click', () => {
      if (trayDrawer && !trayDrawer.hidden) closeTray();
      if (noteInspector && !noteInspector.hidden) closeNoteInspector(true);
    });

    // Diagnóstico técnico M1-M4
    openDetailBtn?.addEventListener('click', openTechDiagnosis);
    closeBtn?.addEventListener('click', closeTechDiagnosis);
    returnBtn?.addEventListener('click', closeTechDiagnosis);
    scrim?.addEventListener('click', closeTechDiagnosis);

    pills.forEach((p) => {
      p.addEventListener('click', () => {
        const k = p.getAttribute('data-wip-state');
        if (k) updateTechMoment(k);
      });
    });

    prevBtn?.addEventListener('click', () => {
      const nextKey = techKeys[(techCurrentIdx - 1 + techKeys.length) % techKeys.length];
      updateTechMoment(nextKey);
    });

    nextBtn?.addEventListener('click', () => {
      const nextKey = techKeys[(techCurrentIdx + 1) % techKeys.length];
      updateTechMoment(nextKey);
    });

    // Tecla Escape para modales y drawer
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (noteInspector && !noteInspector.hidden) {
          e.preventDefault();
          closeNoteInspector(true);
        } else if (trayDrawer && !trayDrawer.hidden) {
          e.preventDefault();
          closeTray();
        } else if (alertToast && !alertToast.hidden) {
          e.preventDefault();
          hideWipAlert();
        } else if (root.getAttribute('data-expanded') === 'true') {
          e.preventDefault();
          closeTechDiagnosis();
        }
      }
    });

    // Render inicial
    renderBoardState();
  }

  initKanbanPhysicalBoard();
  document.addEventListener('astro:page-load', initKanbanPhysicalBoard);
</script>
