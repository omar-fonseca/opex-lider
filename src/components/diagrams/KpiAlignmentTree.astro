---
// Página 08 — KPI: medir lo importante (KPI-UX-01.1 - Consolidación visual)
// Escenario unificado: Franja superior compacta con telemetría y simulador OTIF en vivo,
// sobre un árbol SVG amplio de gran legibilidad y proyección, con soporte pleno de modo claro y oscuro.
---

<div class="interactive-workbench expandable-workbench" id="kpi-tree-workbench" data-expanded="false">

  <!-- Cabecera del banco de trabajo con kicker y estado de interacción -->
  <div class="expandable-header">
    <div class="canvas-Topline">
      <div class="kpi-header-meta">
        <span class="canvas-kicker">ESCENARIO DE ALINEACIÓN ESTRATÉGICA · MEDICIÓN OPERACIONAL</span>
        <span class="canvas-hint" id="kpi-feedback-banner" role="status" aria-live="polite">
          Explora la jerarquía del árbol o ajusta los pedidos conformes en el simulador superior para observar el impacto en tiempo real.
        </span>
      </div>
      <div class="kpi-header-actions">
        <button type="button" class="kpi-action-btn kpi-reset-btn" id="kpi-reset-btn" title="Restaurar el simulador al resultado inicial de la semana (183 de 200 pedidos, 91,5%)">
          <span aria-hidden="true">↺</span> Reiniciar simulador
        </button>
        <button type="button" class="kpi-action-btn kpi-expand-btn" id="kpi-open-inspector-btn" aria-haspopup="dialog" title="Ampliar ficha técnica detallada del nodo seleccionado">
          <span aria-hidden="true">↗</span> Ficha técnica [01–05]
        </button>
      </div>
    </div>
  </div>

  <div class="expandable-stage" id="kpi-stage">

    <!-- ESCENARIO UNIFICADO: FRANJA SUPERIOR COMPACTA + ÁRBOL SVG AMPLIO -->
    <div class="kpi-unified-stage">

      <!-- 1. FRANJA SUPERIOR COMPACTA: Telemetría OTIF, Medidor interactivo y Control Deslizante -->
      <div class="kpi-top-telemetry-bar" role="region" aria-label="Telemetría y simulador semanal OTIF">

        <!-- Bloque de Métricas Operacionales Clave -->
        <div class="kpi-telemetry-metrics">

          <!-- Métrica 1: Resultado OTIF -->
          <div class="kpi-telemetry-item">
            <span class="kpi-t-label">RESULTADO SEMANAL</span>
            <div class="kpi-t-val-row">
              <strong class="kpi-t-val" id="otif-percent-display">91,5 %</strong>
              <span class="kpi-t-status-badge is-near" id="otif-status-badge">Por debajo</span>
            </div>
            <span class="kpi-t-sub" id="otif-ratio-display">183 de 200 pedidos</span>
          </div>

          <div class="kpi-t-divider" aria-hidden="true"></div>

          <!-- Métrica 2: Meta Operacional -->
          <div class="kpi-telemetry-item">
            <span class="kpi-t-label">META ACORDADA</span>
            <div class="kpi-t-val-row">
              <strong class="kpi-t-val kpi-val-target">≥ 96,0 %</strong>
            </div>
            <span class="kpi-t-sub">192 pedidos mínimos</span>
          </div>

          <div class="kpi-t-divider" aria-hidden="true"></div>

          <!-- Métrica 3: Brecha de Desempeño -->
          <div class="kpi-telemetry-item">
            <span class="kpi-t-label">BRECHA DE DESVÍO</span>
            <div class="kpi-t-val-row">
              <strong class="kpi-t-val kpi-val-gap" id="otif-gap-display">−4,5 pp</strong>
            </div>
            <span class="kpi-t-sub" id="otif-needed-display">Faltan 9 conformes</span>
          </div>

          <div class="kpi-t-divider" aria-hidden="true"></div>

          <!-- Medidor comparativo con barra de progreso y marcador de meta al 96% -->
          <div class="kpi-telemetry-progress-block">
            <div class="kpi-prog-head">
              <span class="kpi-t-label">CUMPLIMIENTO VS META</span>
              <span class="kpi-target-tag">Meta 96% (192)</span>
            </div>
            <div class="kpi-prog-track" aria-hidden="true">
              <div class="kpi-prog-fill" id="otif-progress-bar" style="width: 91.5%;"></div>
              <div class="kpi-prog-target-line" style="left: 96%;" title="Meta operacional: 96%"></div>
            </div>
          </div>

        </div>

        <!-- Bloque del Control Deslizante Integrado (Sin duplicar indicadores) -->
        <div class="kpi-telemetry-slider-block">
          <div class="kpi-slider-header">
            <label for="otif-compliant-slider" class="kpi-slider-label">
              Simular pedidos conformes:
            </label>
            <span class="kpi-slider-value-pill" id="slider-counter-display">183 / 200</span>
          </div>
          <div class="kpi-slider-controls">
            <input
              type="range"
              id="otif-compliant-slider"
              class="kpi-slider-input"
              min="140"
              max="200"
              step="1"
              value="183"
              aria-label="Ajustar cantidad de pedidos conformes"
              aria-valuemin="140"
              aria-valuemax="200"
              aria-valuenow="183"
              aria-valuetext="183 pedidos conformes de 200 (91,5% OTIF)"
            />
            <div class="kpi-slider-presets">
              <button type="button" class="kpi-preset-pill is-active" id="preset-initial" title="Fijar en el resultado inicial semanal (183 conformes, 91,5%)">
                Inicial (183)
              </button>
              <button type="button" class="kpi-preset-pill" id="preset-target" title="Fijar exactamente en la meta (192 conformes, 96,0%)">
                Meta (192)
              </button>
              <button type="button" class="kpi-preset-pill" id="preset-optimum" title="Fijar en excelencia 100% (200 conformes)">
                100% (200)
              </button>
            </div>
          </div>
        </div>

      </div>

      <!-- 2. Píldoras de Navegación de Nodos del Árbol (01 al 05) -->
      <div class="stage-selector-bar kpi-node-pills-bar" role="tablist" aria-label="Niveles del árbol de medición KPI">
        <button type="button" class="stage-pill-btn is-active" role="tab" aria-selected="true" data-kpi-node="proposito">
          <span class="stage-pill-num">01</span> Propósito
        </button>
        <button type="button" class="stage-pill-btn" role="tab" aria-selected="false" data-kpi-node="objetivo">
          <span class="stage-pill-num">02</span> Objetivo
        </button>
        <button type="button" class="stage-pill-btn" role="tab" aria-selected="false" data-kpi-node="indicador">
          <span class="stage-pill-num">03</span> Indicador (KPI)
        </button>
        <button type="button" class="stage-pill-btn" role="tab" aria-selected="false" data-kpi-node="meta">
          <span class="stage-pill-num">04</span> Meta
        </button>
        <button type="button" class="stage-pill-btn" role="tab" aria-selected="false" data-kpi-node="resultado">
          <span class="stage-pill-num">05</span> Resultado
        </button>
      </div>

      <!-- 3. ÁRBOL SVG PRINCIPAL DE GRAN TAMAÑO Y PROYECCIÓN -->
      <div class="workbench-canvas expandable-canvas-wrap kpi-tree-canvas" id="kpi-canvas-wrap">
        <svg class="interactive-svg kpi-hero-svg" viewBox="0 0 920 410" role="img" aria-label="Árbol jerárquico navegable: Propósito, Objetivo, Indicador, Meta y Resultado con ejemplo ilustrativo">
          <!-- Conectores del árbol -->
          <g class="kpi-connector-group" stroke="var(--accent-strong)" stroke-width="2.6" fill="none">
            <line x1="460" y1="74" x2="460" y2="100" class="kpi-connector-line" />
            <line x1="460" y1="162" x2="460" y2="188" class="kpi-connector-line" />
            <path d="M 460 252 L 460 272 L 255 272 L 255 292" class="kpi-connector-line" />
            <path d="M 460 252 L 460 272 L 665 272 L 665 292" class="kpi-connector-line" />
          </g>

          <!-- Conector de comparación horizontal entre Meta y Resultado con Brecha viva -->
          <line x1="415" y1="334" x2="505" y2="334" id="svg-tree-gap-line" class="kpi-gap-line" stroke="#f59e0b" stroke-width="2.4" stroke-dasharray="4 4" />
          <text x="460" y="324" text-anchor="middle" id="svg-tree-gap-text" class="kpi-gap-text" font-family="DM Sans, sans-serif" font-size="11.5" font-weight="800">BRECHA: −4,5 pp</text>

          <!-- NODO 1: PROPÓSITO -->
          <g class="svg-node-group is-active" data-kpi-target="proposito" tabindex="0" role="button" aria-haspopup="dialog" aria-expanded="false" aria-label="Nivel 1: Propósito. Seleccionar para examinar">
            <rect class="node-card-bg kpi-svg-card" x="180" y="14" width="560" height="60" rx="12" />
            <text x="206" y="36" class="kpi-svg-kicker" font-family="DM Sans, sans-serif" font-size="10" font-weight="800" letter-spacing="1.2">01 · PROPÓSITO (¿PARA QUÉ EXISTE EL PROCESO?)</text>
            <text x="716" y="36" text-anchor="end" class="kpi-svg-action" font-family="DM Sans, sans-serif" font-size="9.5" font-weight="700">⤢ AMPLIAR</text>
            <text x="206" y="57" class="kpi-svg-title" font-family="Playfair Display, Georgia, serif" font-size="16.5" font-weight="700">Asegurar continuidad operativa y entregas confiables al cliente</text>
          </g>

          <!-- NODO 2: OBJETIVO -->
          <g class="svg-node-group" data-kpi-target="objetivo" tabindex="0" role="button" aria-haspopup="dialog" aria-expanded="false" aria-label="Nivel 2: Objetivo. Seleccionar para examinar">
            <rect class="node-card-bg kpi-svg-card" x="180" y="100" width="560" height="62" rx="12" />
            <text x="206" y="122" class="kpi-svg-kicker" font-family="DM Sans, sans-serif" font-size="10" font-weight="800" letter-spacing="1.2">02 · OBJETIVO (¿QUÉ CAMBIO BUSCAMOS LOGRAR?)</text>
            <text x="716" y="122" text-anchor="end" class="kpi-svg-action" font-family="DM Sans, sans-serif" font-size="9.5" font-weight="700">⤢ AMPLIAR</text>
            <text x="206" y="145" class="kpi-svg-title" font-family="Playfair Display, Georgia, serif" font-size="16.5" font-weight="700">Cumplir las entregas completas y en la ventana horaria acordada</text>
          </g>

          <!-- NODO 3: INDICADOR (KPI) -->
          <g class="svg-node-group" data-kpi-target="indicador" tabindex="0" role="button" aria-haspopup="dialog" aria-expanded="false" aria-label="Nivel 3: Indicador KPI. Seleccionar para examinar">
            <rect class="node-card-bg kpi-svg-card" x="150" y="188" width="620" height="64" rx="12" />
            <text x="176" y="210" class="kpi-svg-kicker" font-family="DM Sans, sans-serif" font-size="10" font-weight="800" letter-spacing="1.2">03 · INDICADOR / KPI (¿CÓMO LO MEDIMOS CON FÓRMULA CLARA?)</text>
            <text x="746" y="210" text-anchor="end" class="kpi-svg-action" font-family="DM Sans, sans-serif" font-size="9.5" font-weight="700">⤢ AMPLIAR</text>
            <text x="176" y="232" class="kpi-svg-title kpi-svg-formula" font-family="Manrope, sans-serif" font-size="14.5" font-weight="800">Cumplimiento OTIF (%) = (Pedidos conformes / 200 total) × 100</text>
            <text x="176" y="246" class="kpi-svg-sub" font-family="DM Sans, sans-serif" font-size="11">Caso operacional semanal sobre 200 pedidos programados</text>
          </g>

          <!-- NODO 4: META (Abajo Izquierda) -->
          <g class="svg-node-group" data-kpi-target="meta" tabindex="0" role="button" aria-haspopup="dialog" aria-expanded="false" aria-label="Nivel 4: Meta. Seleccionar para examinar">
            <rect class="node-card-bg kpi-meta-card" x="90" y="292" width="325" height="84" rx="12" />
            <text x="112" y="314" class="kpi-meta-kicker" font-family="DM Sans, sans-serif" font-size="10" font-weight="800" letter-spacing="1.2">04 · META (UMBRAL ESPERADO)</text>
            <text x="395" y="314" text-anchor="end" class="kpi-meta-action" font-family="DM Sans, sans-serif" font-size="9.5" font-weight="700">⤢</text>
            <text x="112" y="344" class="kpi-meta-val" font-family="Playfair Display, Georgia, serif" font-size="24" font-weight="800">≥ 96,0 %</text>
            <text x="226" y="343" class="kpi-meta-sub" font-family="Manrope, sans-serif" font-size="12">(192 de 200 pedidos)</text>
            <text x="112" y="364" class="kpi-meta-note" font-family="DM Sans, sans-serif" font-size="11">Referencia de estabilidad del proceso</text>
          </g>

          <!-- NODO 5: RESULTADO (Abajo Derecha - Actualizado en tiempo real por el simulador) -->
          <g class="svg-node-group" data-kpi-target="resultado" tabindex="0" role="button" aria-haspopup="dialog" aria-expanded="false" aria-label="Nivel 5: Resultado semanal. Seleccionar para examinar">
            <rect class="node-card-bg kpi-result-card" id="svg-result-rect" x="505" y="292" width="325" height="84" rx="12" />
            <text x="527" y="314" class="kpi-result-kicker" id="svg-result-kicker" font-family="DM Sans, sans-serif" font-size="10" font-weight="800" letter-spacing="1.2">05 · RESULTADO REAL (SEMANA)</text>
            <text x="810" y="314" text-anchor="end" class="kpi-result-action" font-family="DM Sans, sans-serif" font-size="9.5" font-weight="700">⤢</text>
            <text x="527" y="344" class="kpi-result-val" id="svg-node-result-val" font-family="Playfair Display, Georgia, serif" font-size="24" font-weight="800">91,5 %</text>
            <text x="625" y="343" class="kpi-result-sub" id="svg-node-result-sub" font-family="Manrope, sans-serif" font-size="12">(183 de 200 pedidos)</text>
            <text x="527" y="364" class="kpi-result-note" id="svg-node-result-note" font-family="DM Sans, sans-serif" font-size="11">Faltan 9 pedidos para cerrar la brecha</text>
          </g>
        </svg>
      </div>

      <!-- 4. Cuadro de Contexto e Interpretación Operacional del Nodo Seleccionado -->
      <div class="kpi-node-insight-bar" id="kpi-node-insight" role="region" aria-label="Interpretación operacional del nivel seleccionado">
        <div class="kpi-insight-header">
          <span class="kpi-insight-badge" id="insight-badge">01 · PROPÓSITO</span>
          <span class="kpi-insight-guide">Guía de gestión operacional</span>
        </div>
        <p class="kpi-insight-text" id="insight-text">
          El propósito asegura que la medición proteja la promesa de servicio hacia el cliente. El número no existe por sí mismo: existe para garantizar entregas confiables y predecibles.
        </p>
      </div>

    </div>

    <!-- Velo de enfoque contextual para la ficha técnica expandida -->
    <div class="expandable-scrim" id="kpi-scrim" aria-hidden="true" title="Cerrar ficha ampliada"></div>

    <!-- FICHA TÉCNICA EXPANDIDA FLIP (NIVELES 01 A 05) -->
    <aside
      class="expanded-editorial-card"
      id="kpi-inspector"
      role="dialog"
      aria-modal="false"
      aria-labelledby="kpi-title"
      aria-hidden="true"
      hidden
    >
      <div class="expanded-topbar">
        <div class="inspector-badge-row">
          <span class="inspector-tag" id="kpi-tag">NIVEL 01 · PROPÓSITO</span>
          <span class="inspector-step-indicator" id="kpi-step">Nodo 1 de 5</span>
        </div>

        <button
          type="button"
          class="expanded-close-btn"
          id="kpi-close-btn"
          aria-label="Cerrar ficha ampliada y regresar al árbol KPI"
          title="Cerrar (Escape)"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          <span>Cerrar</span>
        </button>
      </div>

      <div class="expanded-body">
        <div class="stage-selector-bar" role="tablist" aria-label="Navegar entre nodos en la ficha ampliada">
          <button type="button" class="stage-pill-btn is-active" role="tab" aria-selected="true" data-modal-pill="proposito">
            <span class="stage-pill-num">01</span> Propósito
          </button>
          <button type="button" class="stage-pill-btn" role="tab" aria-selected="false" data-modal-pill="objetivo">
            <span class="stage-pill-num">02</span> Objetivo
          </button>
          <button type="button" class="stage-pill-btn" role="tab" aria-selected="false" data-modal-pill="indicador">
            <span class="stage-pill-num">03</span> Indicador (KPI)
          </button>
          <button type="button" class="stage-pill-btn" role="tab" aria-selected="false" data-modal-pill="meta">
            <span class="stage-pill-num">04</span> Meta
          </button>
          <button type="button" class="stage-pill-btn" role="tab" aria-selected="false" data-modal-pill="resultado">
            <span class="stage-pill-num">05</span> Resultado
          </button>
        </div>

        <div>
          <h3 class="expanded-title" id="kpi-title">Propósito: la razón de ser antes del número</h3>
          <p class="expanded-summary" id="kpi-summary">
            Ningún indicador tiene sentido en el vacío. Antes de definir una fórmula, el líder y el equipo deben responder con claridad: ¿qué promesa de valor hace este proceso a sus clientes y a la organización?
          </p>
        </div>

        <div class="expanded-details-grid">
          <div class="inspector-detail-box">
            <span>RELACIÓN CON EL SIGUIENTE ESLABÓN</span>
            <p id="kpi-relation">
              El propósito no se mide directamente: se desglosa en objetivos concretos que puedan transformarse en señales observables de desempeño.
            </p>
          </div>
          <div class="inspector-detail-box">
            <span>EJEMPLO OPERATIVO ILUSTRATIVO</span>
            <p id="kpi-example">
              «Garantizar que cada cliente reciba exactamente lo contratado, en la fecha prometida y sin retrasos que interrumpan su operación diaria.»
            </p>
          </div>
        </div>

        <div class="expanded-footer-nav">
          <button type="button" class="step-nav-btn" id="kpi-prev-btn" aria-label="Ver nodo anterior">
            ← Nodo anterior
          </button>
          <button type="button" class="expanded-return-btn" id="kpi-return-btn">
            Volver al árbol y dashboard
          </button>
          <button type="button" class="step-nav-btn" id="kpi-next-btn" aria-label="Ver siguiente nodo">
            Siguiente nodo →
          </button>
        </div>
      </div>
    </aside>

  </div>
</div>

<style>
  /* =========================================================================
     ESTILOS DEL ESCENARIO CONSOLIDADO KPI (KPI-UX-01.1)
     ========================================================================= */

  .interactive-workbench[hidden],
  .expanded-editorial-card[hidden],
  .expandable-scrim[hidden] {
    display: none !important;
  }

  .kpi-header-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .kpi-header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .kpi-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    background: var(--surface-card, #0f172a);
    border: 1px solid var(--line, #334155);
    color: var(--text-secondary, #94a3b8);
  }

  .kpi-action-btn:hover {
    border-color: var(--accent-strong, #38bdf8);
    color: var(--text-primary, #f8fafc);
    transform: translateY(-1px);
  }

  .kpi-action-btn:focus-visible {
    outline: 2px solid var(--accent-strong, #38bdf8);
    outline-offset: 2px;
  }

  html[data-theme="light"] .kpi-action-btn {
    background: #ffffff;
    border-color: #cbd5e1;
    color: #475569;
  }

  html[data-theme="light"] .kpi-action-btn:hover {
    border-color: var(--accent-strong, #0284c7);
    color: #0f172a;
    background: #f1f5f9;
  }

  .kpi-expand-btn {
    border-color: var(--accent-border, rgba(56, 189, 248, 0.4));
    color: var(--accent-text, #38bdf8);
  }

  /* Contenedor unificado */
  .kpi-unified-stage {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 10px;
  }

  /* =========================================================================
     1. FRANJA SUPERIOR COMPACTA (TELEMETRÍA + SIMULADOR INTEGRADO)
     ========================================================================= */

  .kpi-top-telemetry-bar {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 18px;
    align-items: center;
    background: var(--surface-card, #0c182e);
    border: 1.5px solid var(--accent-border, rgba(56, 189, 248, 0.35));
    border-radius: 14px;
    padding: 14px 18px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  html[data-theme="light"] .kpi-top-telemetry-bar {
    background: #ffffff;
    border-color: #cbd5e1;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
  }

  /* Bloque de Métricas */
  .kpi-telemetry-metrics {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .kpi-telemetry-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 105px;
  }

  .kpi-t-label {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--text-muted, #64748b);
    text-transform: uppercase;
  }

  .kpi-t-val-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .kpi-t-val {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--text-primary, #f8fafc);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  html[data-theme="light"] .kpi-t-val {
    color: #0f172a;
  }

  .kpi-val-target {
    color: #4ade80 !important;
  }

  html[data-theme="light"] .kpi-val-target {
    color: #16a34a !important;
  }

  .kpi-val-gap {
    color: #fde68a;
  }

  html[data-theme="light"] .kpi-val-gap {
    color: #b45309;
  }

  .kpi-t-status-badge {
    font-size: 0.6rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .kpi-t-status-badge.is-near {
    background: rgba(245, 158, 11, 0.2);
    color: #fbbf24;
    border: 1px solid #f59e0b;
  }

  html[data-theme="light"] .kpi-t-status-badge.is-near {
    background: #fef3c7;
