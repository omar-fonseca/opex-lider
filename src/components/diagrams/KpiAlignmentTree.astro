<script>
  import { animateFlipOpen, animateFlipClose } from '../../lib/expandableCardEngine';
  import {
    TOTAL_WEEKLY_ORDERS,
    TARGET_OTIF_PERCENT,
    INITIAL_COMPLIANT_ORDERS,
    calculateOtif,
  } from '../../lib/otifEngine';

  function initKpiAlignmentTree() {
    const root = document.getElementById('kpi-tree-workbench');
    if (!root) return;

    // Elementos de la Telemetría Superior Compacta
    const otifPercentDisplay = document.getElementById('otif-percent-display');
    const otifStatusBadge = document.getElementById('otif-status-badge');
    const otifRatioDisplay = document.getElementById('otif-ratio-display');
    const otifGapDisplay = document.getElementById('otif-gap-display');
    const otifNeededDisplay = document.getElementById('otif-needed-display');
    const otifProgressBar = document.getElementById('otif-progress-bar');

    // Control deslizante y presets
    const slider = document.getElementById('otif-compliant-slider') as HTMLInputElement | null;
    const sliderCounterDisplay = document.getElementById('slider-counter-display');
    const presetInitial = document.getElementById('preset-initial');
    const presetTarget = document.getElementById('preset-target');
    const presetOptimum = document.getElementById('preset-optimum');
    const resetBtn = document.getElementById('kpi-reset-btn');

    // Elementos reactivos en el Árbol SVG
    const svgTreeGapLine = document.getElementById('svg-tree-gap-line');
    const svgTreeGapText = document.getElementById('svg-tree-gap-text');
    const svgNodeResultVal = document.getElementById('svg-node-result-val');
    const svgNodeResultSub = document.getElementById('svg-node-result-sub');
    const svgNodeResultNote = document.getElementById('svg-node-result-note');
    const svgResultRect = document.getElementById('svg-result-rect');
    const svgResultKicker = document.getElementById('svg-result-kicker');

    // Cuadro de Interpretación del Nodo
    const insightBadge = document.getElementById('insight-badge');
    const insightText = document.getElementById('insight-text');
    const feedbackBanner = document.getElementById('kpi-feedback-banner');

    // Ficha Técnica Expandible (Modal FLIP)
    const inspector = document.getElementById('kpi-inspector');
    const openInspectorBtn = document.getElementById('kpi-open-inspector-btn');
    const closeBtn = document.getElementById('kpi-close-btn');
    const returnBtn = document.getElementById('kpi-return-btn');
    const prevBtn = document.getElementById('kpi-prev-btn');
    const nextBtn = document.getElementById('kpi-next-btn');
    const scrim = document.getElementById('kpi-scrim');

    const pills = Array.from(root.querySelectorAll<HTMLButtonElement>('.kpi-node-pills-bar .stage-pill-btn'));
    const modalPills = Array.from(root.querySelectorAll<HTMLButtonElement>('.expanded-body .stage-pill-btn'));
    const svgNodes = Array.from(root.querySelectorAll<SVGGElement>('.svg-node-group'));

    const tagEl = document.getElementById('kpi-tag');
    const stepEl = document.getElementById('kpi-step');
    const titleEl = document.getElementById('kpi-title');
    const summaryEl = document.getElementById('kpi-summary');
    const relEl = document.getElementById('kpi-relation');
    const exEl = document.getElementById('kpi-example');

    // Datos editoriales y operativos de los 5 niveles
    const NODES: Record<string, {
      tag: string;
      step: string;
      title: string;
      summary: string;
      relation: string;
      example: string;
      insight: string;
    }> = {
      proposito: {
        tag: 'NIVEL 01 · PROPÓSITO',
        step: 'Nodo 1 de 5',
        title: 'Propósito: la razón de ser antes del número',
        summary: 'Ningún indicador tiene sentido en el vacío. Antes de definir una fórmula, el líder y el equipo deben responder con claridad: ¿qué promesa de valor hace este proceso a sus clientes y a la organización?',
        relation: 'El propósito no se mide directamente: se desglosa en objetivos concretos que puedan transformarse en señales observables de desempeño.',
        example: '«Garantizar que cada cliente reciba exactamente lo contratado, en la fecha prometida y sin retrasos que interrumpan su operación diaria.»',
        insight: 'El propósito asegura que la medición proteja la promesa de servicio hacia el cliente. El número no existe por sí mismo: existe para garantizar entregas confiables y predecibles.',
      },
      objetivo: {
        tag: 'NIVEL 02 · OBJETIVO',
        step: 'Nodo 2 de 5',
        title: 'Objetivo: el cambio observable que se busca',
        summary: 'Traduce el propósito general en una dirección precisa de mejora o estabilidad. Define qué resultado operacional se espera alcanzar.',
        relation: 'El objetivo declara la intención; el indicador establece el instrumento matemático que permitirá verificar si esa intención se cumple.',
        example: '«Entregar completos y a tiempo los 200 pedidos semanales comprometidos con la red de distribución.»',
        insight: 'El objetivo operacional fija la meta de entrega íntegra sobre el total de 200 pedidos semanales comprometidos con la red de clientes.',
      },
      indicador: {
        tag: 'NIVEL 03 · INDICADOR (KPI)',
        step: 'Nodo 3 de 5',
        title: 'Indicador: la regla objetiva de cálculo',
        summary: 'Fórmula cuantitativa que convierte el cumplimiento en una métrica repetible y auditable. Un buen KPI une calidad y puntualidad sin ambigüedades.',
        relation: 'El indicador proporciona la escala de medición; la meta define sobre esa misma escala el valor numérico considerado satisfactorio.',
        example: '«Cumplimiento OTIF (%) = (Pedidos conformes / Total pedidos) × 100 sobre los 200 pedidos de la semana.»',
        insight: 'Fórmula OTIF: (Pedidos Conformes / 200) × 100. Combina en una sola regla matemática el producto completo (In-Full) y la puntualidad (On-Time).',
      },
      meta: {
        tag: 'NIVEL 04 · META',
        step: 'Nodo 4 de 5',
        title: 'Meta: el umbral de estabilidad acordado',
        summary: 'Establece la frontera entre lo aceptable y lo inaceptable. No es un deseo ni un techo arbitrario: es el estándar de confiabilidad pactado.',
        relation: 'La meta por sí sola es un estándar inerte; solo adquiere significado cuando se confronta periódicamente contra el resultado obtenido.',
        example: '«Lograr un OTIF semanal ≥ 96,0% (equivalente a 192 de los 200 pedidos conformes).»',
        insight: 'Meta fijada en 96,0 % (192 pedidos). Marca la cota mínima de estabilidad: por debajo de 96%, el proceso activa revisión de causa raíz.',
      },
      resultado: {
        tag: 'NIVEL 05 · RESULTADO',
        step: 'Nodo 5 de 5',
        title: 'Resultado: la realidad frente a la meta',
        summary: 'Muestra lo que ocurrió en el período medido. La comparación directa entre meta y resultado revela la brecha de desempeño.',
        relation: 'La brecha entre el 96,0% esperado y el resultado real es la señal de control: si es negativa, activa la reunión de análisis y contención.',
        example: '«Semana actual: 91,5% (183 de 200 pedidos conformes). Brecha de −4,5 pp (faltan 9 pedidos conformes para cumplir la meta).»',
        insight: 'Resultado en vivo. La brecha con la meta indica de inmediato los pedidos conformes adicionales necesarios para recuperar el estándar.',
      },
    };

    const keys = ['proposito', 'objetivo', 'indicador', 'meta', 'resultado'];
    let activeKey = 'proposito';
    let activeOriginEl: HTMLElement | SVGElement | null = null;
    let isExpanded = false;

    // =========================================================================
    // ACTUALIZACIÓN DE TELEMETRÍA Y ÁRBOL SEGÚN SIMULADOR OTIF
    // =========================================================================

    function updateSimulation(compliantCount: number) {
      const data = calculateOtif(compliantCount);
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';

      // 1. Franja de Telemetría Superior
      if (otifPercentDisplay) otifPercentDisplay.textContent = data.formattedOtif;
      if (otifRatioDisplay) otifRatioDisplay.textContent = `${data.compliantOrders} de ${TOTAL_WEEKLY_ORDERS} pedidos`;
      if (otifGapDisplay) {
        otifGapDisplay.textContent = data.formattedGap;
        otifGapDisplay.style.color = data.isTargetMet ? (isLight ? '#16a34a' : '#4ade80') : (isLight ? '#b45309' : '#fde68a');
      }

      if (otifNeededDisplay) {
        otifNeededDisplay.textContent = data.isTargetMet
          ? '✓ Meta cumplida'
          : `Faltan ${data.additionalOrdersNeeded} conformes`;
      }

      if (otifStatusBadge) {
        otifStatusBadge.textContent = data.isTargetMet ? 'En meta' : (data.statusLevel === 'near' ? 'Por debajo' : 'Crítico');
        otifStatusBadge.className = `kpi-t-status-badge is-${data.statusLevel}`;
      }

      if (otifProgressBar) {
        otifProgressBar.style.width = `${Math.min(100, Math.max(0, data.otifPercent))}%`;
        if (data.isTargetMet) {
          otifProgressBar.style.background = 'linear-gradient(90deg, #16a34a, #4ade80)';
        } else if (data.statusLevel === 'near') {
          otifProgressBar.style.background = 'linear-gradient(90deg, #d97706, #fbbf24)';
        } else {
          otifProgressBar.style.background = 'linear-gradient(90deg, #dc2626, #f87171)';
        }
      }

      // 2. Control deslizante
      if (slider) {
        slider.value = String(data.compliantOrders);
        slider.setAttribute('aria-valuenow', String(data.compliantOrders));
        slider.setAttribute('aria-valuetext', `${data.compliantOrders} pedidos conformes de 200 (${data.formattedOtif})`);
      }
      if (sliderCounterDisplay) {
        sliderCounterDisplay.textContent = `${data.compliantOrders} / ${TOTAL_WEEKLY_ORDERS}`;
      }

      // Presets activos
      presetInitial?.classList.toggle('is-active', data.compliantOrders === INITIAL_COMPLIANT_ORDERS);
      presetTarget?.classList.toggle('is-active', data.compliantOrders === 192);
      presetOptimum?.classList.toggle('is-active', data.compliantOrders === TOTAL_WEEKLY_ORDERS);

      // 3. Sincronización en vivo en el Árbol SVG
      if (svgTreeGapText) {
        svgTreeGapText.textContent = `BRECHA: ${data.formattedGap}`;
        svgTreeGapText.style.fill = data.isTargetMet ? (isLight ? '#15803d' : '#6ee7b7') : (isLight ? '#92400e' : '#fde68a');
      }

      if (svgTreeGapLine) {
        svgTreeGapLine.style.stroke = data.isTargetMet ? '#22c55e' : (isLight ? '#d97706' : '#f59e0b');
      }

      if (svgNodeResultVal) svgNodeResultVal.textContent = data.formattedOtif;
      if (svgNodeResultSub) svgNodeResultSub.textContent = `(${data.compliantOrders} de 200 pedidos)`;

      if (svgNodeResultNote) {
        if (data.isTargetMet) {
          svgNodeResultNote.textContent = '✓ Proceso en meta (estabilidad asegurada)';
          svgNodeResultNote.style.fill = isLight ? '#15803d' : '#6ee7b7';
        } else {
          svgNodeResultNote.textContent = `Faltan ${data.additionalOrdersNeeded} pedidos para cerrar la brecha`;
          svgNodeResultNote.style.fill = isLight ? '#64748b' : '#cbd5e1';
        }
      }

      if (svgResultRect) {
        if (data.isTargetMet) {
          svgResultRect.style.stroke = '#22c55e';
          svgResultRect.style.fill = isLight ? '#f0fdf4' : 'rgba(14, 33, 50, 0.94)';
        } else {
          svgResultRect.style.stroke = isLight ? '#d97706' : 'rgba(251, 191, 36, 0.55)';
          svgResultRect.style.fill = isLight ? '#fffbeb' : 'rgba(42, 28, 16, 0.92)';
        }
      }

      if (exEl && activeKey === 'resultado') {
        exEl.textContent = `Semana simulada: ${data.formattedOtif} (${data.compliantOrders} de 200 pedidos conformes). Brecha de ${data.formattedGap} (${data.additionalOrdersNeeded === 0 ? 'meta cumplida' : 'faltan ' + data.additionalOrdersNeeded + ' pedidos conformes'}).`;
      }
    }

    // =========================================================================
    // SELECCIÓN DE NODOS DEL ÁRBOL
    // =========================================================================

    function selectNode(key: string) {
      if (!NODES[key]) return;
      activeKey = key;
      const nodeData = NODES[key];

      pills.forEach((p) => {
        const isSelected = p.getAttribute('data-kpi-node') === key;
        p.classList.toggle('is-active', isSelected);
        p.setAttribute('aria-selected', isSelected ? 'true' : 'false');
      });

      svgNodes.forEach((n) => {
        const isTarget = n.getAttribute('data-kpi-target') === key;
        n.classList.toggle('is-active', isTarget);
        n.setAttribute('aria-expanded', isTarget ? 'true' : 'false');
      });

      if (insightBadge) insightBadge.textContent = nodeData.tag;
      if (insightText) insightText.textContent = nodeData.insight;

      if (feedbackBanner) {
        feedbackBanner.textContent = `Nodo activo: ${nodeData.title}. ${nodeData.insight}`;
      }
    }

    // =========================================================================
    // FICHA TÉCNICA EXPANDIBLE (FLIP)
    // =========================================================================

    function populateModalContent(key: string) {
      const item = NODES[key];
      if (!item) return;

      modalPills.forEach((p) => {
        const isMatch = p.getAttribute('data-modal-pill') === key;
        p.classList.toggle('is-active', isMatch);
        p.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      if (tagEl) tagEl.textContent = item.tag;
      if (stepEl) stepEl.textContent = item.step;
      if (titleEl) titleEl.textContent = item.title;
      if (summaryEl) summaryEl.textContent = item.summary;
      if (relEl) relEl.textContent = item.relation;
      if (exEl) {
        if (key === 'resultado' && slider) {
          const currentData = calculateOtif(Number(slider.value));
          exEl.textContent = `Semana actual: ${currentData.formattedOtif} (${currentData.compliantOrders} de 200 pedidos conformes). Brecha de ${currentData.formattedGap}.`;
        } else {
          exEl.textContent = item.example;
        }
      }
    }

    function openInspector(key: string, originEl?: Element | null) {
      if (!inspector) return;
      selectNode(key);
      populateModalContent(key);

      const targetOrigin = (originEl || root.querySelector(`[data-kpi-target="${key}"]`) || openInspectorBtn) as HTMLElement;
      activeOriginEl = targetOrigin;

      root.setAttribute('data-expanded', 'true');
      inspector.hidden = false;
      inspector.setAttribute('aria-hidden', 'false');
      scrim?.setAttribute('aria-hidden', 'false');

      isExpanded = true;
      animateFlipOpen(targetOrigin, inspector, { durationOpen: 320 });
      setTimeout(() => closeBtn?.focus({ preventScroll: true }), 60);
    }

    function closeInspector() {
      if (!inspector || !isExpanded) return;
      animateFlipClose(activeOriginEl, inspector, { durationClose: 260 }, () => {
        root.setAttribute('data-expanded', 'false');
        inspector.hidden = true;
        inspector.setAttribute('aria-hidden', 'true');
        scrim?.setAttribute('aria-hidden', 'true');
        isExpanded = false;

        if (activeOriginEl && typeof activeOriginEl.focus === 'function') {
          activeOriginEl.focus({ preventScroll: true });
        } else {
          openInspectorBtn?.focus({ preventScroll: true });
        }
      });
    }

    // =========================================================================
    // LISTENERS DE INTERACCIÓN
    // =========================================================================

    slider?.addEventListener('input', (e) => {
      const val = Number((e.target as HTMLInputElement).value);
      updateSimulation(val);
      selectNode('resultado');
    });

    presetInitial?.addEventListener('click', () => {
      updateSimulation(INITIAL_COMPLIANT_ORDERS);
      selectNode('resultado');
    });

    presetTarget?.addEventListener('click', () => {
      updateSimulation(192);
      selectNode('meta');
    });

    presetOptimum?.addEventListener('click', () => {
      updateSimulation(TOTAL_WEEKLY_ORDERS);
      selectNode('resultado');
    });

    resetBtn?.addEventListener('click', () => {
      updateSimulation(INITIAL_COMPLIANT_ORDERS);
      selectNode('proposito');
    });

    pills.forEach((p) => {
      p.addEventListener('click', () => {
        const k = p.getAttribute('data-kpi-node');
        if (k) selectNode(k);
      });
    });

    svgNodes.forEach((n) => {
      n.addEventListener('click', () => {
        const k = n.getAttribute('data-kpi-target');
        if (k) selectNode(k);
      });
      n.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const k = n.getAttribute('data-kpi-target');
          if (k) selectNode(k);
        }
      });
    });

    modalPills.forEach((p) => {
      p.addEventListener('click', () => {
        const k = p.getAttribute('data-modal-pill');
        if (k) {
          selectNode(k);
          populateModalContent(k);
        }
      });
    });

    openInspectorBtn?.addEventListener('click', () => {
      openInspector(activeKey, openInspectorBtn);
    });

    closeBtn?.addEventListener('click', closeInspector);
    returnBtn?.addEventListener('click', closeInspector);
    scrim?.addEventListener('click', closeInspector);

    prevBtn?.addEventListener('click', () => {
      const currentIdx = keys.indexOf(activeKey);
      const nextKey = keys[(currentIdx - 1 + keys.length) % keys.length];
      openInspector(nextKey, prevBtn);
    });

    nextBtn?.addEventListener('click', () => {
      const currentIdx = keys.indexOf(activeKey);
      const nextKey = keys[(currentIdx + 1) % keys.length];
      openInspector(nextKey, nextBtn);
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isExpanded) {
        e.preventDefault();
        closeInspector();
      }
    });

    // Re-render en cambio de tema (claro/oscuro)
    const observer = new MutationObserver(() => {
      if (slider) updateSimulation(Number(slider.value));
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    // Render inicial
    updateSimulation(INITIAL_COMPLIANT_ORDERS);
    selectNode('proposito');
  }

  initKpiAlignmentTree();
  document.addEventListener('astro:page-load', initKpiAlignmentTree);
</script>
