---
import { BOOK_SEARCH_ITEMS } from '../../lib/bookManifest';
---

<div class="search-overlay" id="search-modal" role="dialog" aria-modal="true" aria-label="Buscar en el libro" style="display: none;">
  <button class="search-backdrop" id="search-backdrop" aria-label="Cerrar búsqueda"></button>

  <div class="search-panel">
    <div class="search-panel-head">
      <span>Buscar en OPEX LÍDER (Páginas 00–09)</span>
      <button type="button" id="search-close-btn" aria-label="Cerrar buscador">Cerrar [ESC]</button>
    </div>

    <label for="search-input">
      <span class="search-glyph" aria-hidden="true"></span>
      <input 
        type="search" 
        id="search-input" 
        placeholder="Líder, proceso, gestión visual, Kanban, WIP, KPI…" 
        autocomplete="off"
        spellcheck="false"
      />
    </label>

    <p class="search-caption" id="search-caption">Explora las 10 páginas y conceptos de esta edición</p>

    <div class="search-results" id="search-results" role="listbox">
      {BOOK_SEARCH_ITEMS.map((item, index) => (
        <a 
          href={item.href} 
          class="search-result-item" 
          data-label={`${item.label} ${item.keywords}`.toLowerCase()} 
          role="option"
        >
          <span>{String(index).padStart(2, '0')}</span>
          <div>
            <strong>{item.label}</strong>
            <small style="display: block; color: var(--muted-dark); font-size: 10px; font-family: 'DM Sans', sans-serif;">{item.category}</small>
          </div>
          <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M14 7l5 5-5 5"></path>
          </svg>
        </a>
      ))}
    </div>
  </div>
</div>
