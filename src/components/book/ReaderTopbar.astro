---
import { TOTAL_BOOK_PAGES } from '../../lib/bookManifest';

interface Props {
  kicker: string;
  title: string;
  currentPage: number;
  totalPages?: number;
}

const { kicker, title, currentPage, totalPages = TOTAL_BOOK_PAGES } = Astro.props;
const formattedPage = String(currentPage - 1).padStart(2, "0");
const formattedTotal = String(totalPages - 1).padStart(2, "0");
---

<header class="reader-topbar" role="banner">
  <div class="page-context">
    <!-- Botón interactivo para Mostrar / Ocultar el índice lateral -->
    <button
      type="button"
      class="sidebar-toggle-button"
      id="sidebar-toggle-btn"
      aria-label="Ocultar índice del libro"
      aria-expanded="true"
      aria-controls="book-nav"
    >
      <svg class="sidebar-glyph" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
        <line x1="9" y1="3" x2="9" y2="21"></line>
      </svg>
      <span class="sidebar-toggle-text" id="sidebar-toggle-text">Ocultar índice</span>
    </button>

    <div class="page-context-crumbs">
      <span>{kicker}</span>
      <strong>{title}</strong>
    </div>
  </div>

  <div class="reader-tools">
    <div class="page-count" aria-label={`Página ${formattedPage} de ${formattedTotal} (${currentPage} de ${totalPages} páginas)`} title={`Página ${formattedPage} de ${formattedTotal} en la primera edición`}>
      <span>PÁG. {formattedPage}</span>
      <i aria-hidden="true"></i>
      <span>{formattedTotal} <small class="page-count-tag">ED. 1</small></span>
    </div>

    <!-- Search Tool Button -->
    <button class="tool-button search-button" id="search-open-btn" aria-label="Abrir buscador (Ctrl + K)">
      <span class="search-glyph" aria-hidden="true"></span>
      <span class="tool-text">Buscar</span>
    </button>

    <!-- Theme Toggle Tool Button (Dark / Light) -->
    <button class="tool-button theme-button" id="theme-toggle-btn" aria-label="Cambiar entre modo claro y oscuro" title="Cambiar tema">
      <span class="theme-glyph" aria-hidden="true">
        <!-- Sun icon (shown in dark mode) -->
        <svg class="sun-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="moon-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </span>
      <span class="tool-text theme-name">Tema</span>
    </button>

    <!-- Bookmark Tool Button -->
    <button class="tool-button bookmark-button" id="bookmark-toggle-btn" aria-label="Añadir marcador" aria-pressed="false">
      <span class="bookmark-glyph" aria-hidden="true"></span>
      <span class="tool-text">Guardar</span>
    </button>
  </div>
</header>
